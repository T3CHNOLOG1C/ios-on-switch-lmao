load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

host_library(
    name = "installer",
    srcs = [
        "//boot/installer:apfs.c",
        "//boot/installer:bootfiles.c",
        "//boot/installer:images.c",
        "//boot/installer:manifest.c",
        "//boot/installer:stream.c",
        "//boot/installer:target.c",
    ],
    hdrs = [
        "//boot/installer:apfs.h",
        "//boot/installer:bootfiles.h",
        "//boot/installer:images.h",
        "//boot/installer:manifest.h",
        "//boot/installer:stream.h",
        "//boot/installer:target.h",
    ],
)

run_binary(
    name = "vectors",
    outs = [
        "expected.bin",
        "manifest.bin",
        "source.bin",
    ],
    args = [
        "$(execpath manifest.bin)",
        "$(execpath source.bin)",
        "$(execpath expected.bin)",
    ],
    tool = "//tools/install:manifest_vectors",
)

host_test(
    name = "installer_test",
    srcs = [
        "installer_test.cpp",
        "vectors.h",
    ],
    data = [":vectors"],
    deps = [":installer"],
)

host_test(
    name = "selection_test",
    srcs = [
        "selection_test.cpp",
        "vectors.h",
    ],
    data = [":vectors"],
    deps = [":installer"],
)

host_test(
    name = "apfs_test",
    srcs = ["apfs_test.cpp"],
    deps = [":installer"],
)

# macOS's kernel and fsck_apfs on containers fitted by //boot/installer:apfs_tool: hdiutil and diskutil, outside the
# sandbox (bazel test --strategy=TestRunner=local //boot/installer/test:apfs_fit_test).
py_test(
    name = "apfs_fit_test",
    srcs = ["apfs_fit_test.py"],
    data = ["//boot/installer:apfs_tool"],
    tags = [
        "local",
        "manual",
    ],
    deps = [
        "//tools/install:lib",
        "@rules_python//python/runfiles",
    ],
)
