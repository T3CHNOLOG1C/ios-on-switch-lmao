# The native loader (boot/loader) on the host: its EMC raise, SE2 seed mix, copy page tables, LZ4 window decoder
# (against the builder's own compressor, at build time), CRC-32 helper (the AArch64 routine itself, run natively) and
# FDT memory gate, each against models or independent references; GoogleTest drives every one.
#
#   bazel test //boot/loader/test:all
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

# --- EMC raise: emc.c over the BPMP mailbox / I2C5 / counter model ---------------------------------------------------
host_library(
    name = "emc",
    srcs = [
        "emc_model.c",
        "//boot:loader/emc.c",
    ],
    hdrs = ["//boot:loader/emc.h"],
    copts = ["-O1"],
    defines = ["LOADER_EMC_HOST_TEST=1"],
    deps = ["//bazel/testing:c_check"],
)

host_test(
    name = "emc_test",
    srcs = ["emc_test.cpp"],
    deps = [":emc"],
)

# --- Seed mix: seed.c over the CAR / SE2 / AHB / counter model -------------------------------------------------------
host_library(
    name = "seed",
    srcs = [
        "seed_model.c",
        "//boot:loader/seed.c",
    ],
    hdrs = ["//boot:loader/seed.h"],
    copts = ["-O1"],
    defines = ["IOSW_SEED_HOST_TEST=1"],
    deps = ["//bazel/testing:c_check"],
)

host_test(
    name = "seed_test",
    srcs = ["seed_test.cpp"],
    deps = [":seed"],
)

# --- copy.c: the page-table builder and the window decoder -----------------------------------------------------------
# copy.c as the host builds it: LOADER_COPY_HOST_TEST (plain-C copies, so ASan sees every access) and the empty
# layout.h of host_include. Its page tables' ELF section (.copy_tables, which Mach-O cannot name) becomes `used`: the
# storage stays, unused by the host tests, which pass the builder their own tables.
host_library(
    name = "copy",
    srcs = [
        "host_include/layout.h",
        "//boot:loader/copy.c",
        "//boot:loader/stage.h",
    ],
    hdrs = ["//boot:loader/copy.h"],
    copts = ["-O1"],
    defines = [
        "LOADER_COPY_HOST_TEST=1",
        "_POSIX_C_SOURCE=200112L",
        "section(name)=used",
    ],
    includes = ["host_include"],
)

host_library(
    name = "copy_tables_model",
    srcs = ["copy_tables_model.c"],
    hdrs = ["copy_tables_model.h"],
    copts = ["-O1"],
    defines = ["_POSIX_C_SOURCE=200112L"],
    deps = [
        ":copy",
        "//bazel/testing:c_check",
    ],
)

host_test(
    name = "copy_tables_test",
    srcs = ["copy_tables_test.cpp"],
    deps = [":copy_tables_model"],
)

# The windows the decoder tests read, compressed at build time by the builder itself (build_native_loader.py's
# pack_window and compress_window with //tools:lz4, its stage_into_bl33 and bl33.py's bl33_patch on the pinned
# bl33.bin): the decoder is checked against what the boot package really ships, not a second compressor.
py_binary(
    name = "make_window_vectors",
    srcs = ["make_window_vectors.py"],
    deps = [
        "//tools/package:bl33",
        "//tools/package:kernel_window",
    ],
)

WINDOW_VECTORS = [
    "unpack_blocks.bin",
    "unpack_meta.bin",
    "unpack_stream.bin",
    "unpack_window.bin",
    "bl33_blocks.bin",
    "bl33_image.bin",
    "bl33_meta.bin",
    "bl33_window.bin",
]

genrule(
    name = "window_vectors",
    srcs = ["//bazel/pinned:firmware/bl33.bin"],
    outs = WINDOW_VECTORS,
    cmd = "$(execpath :make_window_vectors) --lz4 $(execpath //tools:lz4) " +
          "--bl33 $(execpath //bazel/pinned:firmware/bl33.bin) --out $(RULEDIR)",
    tools = [
        ":make_window_vectors",
        "//tools:lz4",
    ],
)

host_test(
    name = "copy_unpack_test",
    srcs = [
        "copy_unpack_test.cpp",
        "window_vectors.h",
    ],
    data = [
        "unpack_blocks.bin",
        "unpack_meta.bin",
        "unpack_stream.bin",
        "unpack_window.bin",
    ],
    deps = [":copy"],
)

host_test(
    name = "bl33_window_test",
    srcs = [
        "bl33_window_test.cpp",
        "window_vectors.h",
    ],
    data = [
        "bl33_blocks.bin",
        "bl33_image.bin",
        "bl33_meta.bin",
        "bl33_window.bin",
    ],
    deps = [":copy"],
)

# --- checksum.S: the AArch64 CRC-32 routine, run natively ------------------------------------------------------------
# The file for Mach-O: its ELF-only .type and .size lines dropped and the symbol given Mach-O's leading underscore.
genrule(
    name = "checksum_host",
    srcs = ["//boot:loader/checksum.S"],
    outs = ["checksum_host.S"],
    cmd = "sed -e '/^\\.type /d' -e '/^\\.size /d' -e 's/loader_crc32_update/_loader_crc32_update/g' $< > $@",
)

host_library(
    name = "checksum",
    srcs = [":checksum_host"],
)

# zlib's crc32, the independent reference (the macOS SDK's libz). host_test sets the test's own linkopts.
host_library(
    name = "zlib",
    linkopts = ["-lz"],
)

host_test(
    name = "crc_test",
    srcs = ["crc_test.cpp"],
    deps = [
        ":checksum",
        ":zlib",
    ],
)

# --- memory.c: the FDT memory gate ------------------------------------------------------------------------------------
host_library(
    name = "memory",
    srcs = [
        "//boot:loader/memory.c",
        "//boot:loader/ram.h",
    ],
    hdrs = ["//boot:loader/memory.h"],
    copts = ["-O2"],
)

# The parser before r9-preboot round 4, verbatim, under its own name.
host_library(
    name = "memory_reference",
    srcs = [
        "memory_reference.c",
        "//boot:loader/memory.h",
        "//boot:loader/ram.h",
    ],
    copts = ["-O1"],
    defines = ["loader_check_fdt_memory=reference_loader_check_fdt_memory"],
)

host_test(
    name = "memory_gate_test",
    srcs = [
        "fdt_builder.h",
        "memory_gate_test.cpp",
    ],
    deps = [":memory"],
)

host_test(
    name = "memory_ranges_test",
    srcs = [
        "fdt_builder.h",
        "memory_ranges_test.cpp",
    ],
    deps = [
        ":memory",
        ":memory_reference",
    ],
)
