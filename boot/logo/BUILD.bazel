load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

py_library(
    name = "raster",
    srcs = ["raster.py"],
    imports = ["."],
)

py_binary(
    name = "logo",
    srcs = ["logo.py"],
    deps = [":raster"],
)

run_binary(
    name = "pictures",
    srcs = ["apple-logo.svg"],
    outs = [
        "apple-logo~ipad.png",
        "bootlogo.bmp",
        "icon_ios.bmp",
    ],
    args = [
        "--svg=$(execpath apple-logo.svg)",
        "--progressui=$(execpath apple-logo~ipad.png)",
        "--bootlogo=$(execpath bootlogo.bmp)",
        "--icon=$(execpath icon_ios.bmp)",
    ],
    tool = ":logo",
)

py_test(
    name = "logo_test",
    size = "small",
    srcs = ["logo_test.py"],
    data = [
        ":pictures",
        "//tools/package:adt_edit.py",
    ],
    deps = [
        "//tools/package:loader_abi",
        "@rules_python//python/runfiles",
    ],
)
