# The loader's storage code (boot/storage) on the host, each against an independent model or image built here:
# GPT qualification, the FAT32 reader, the raw APFS block backend, the same-boot SD reference page and the read-only
# SDHCI PIO reader. (block/: the NativeIOSwitchBlock driver of boot/storage.)
#
#   bazel test //boot/storage/test/...
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

# zlib's crc32: the independent CRC-32 the GPT and SD reference fixtures are built with (the macOS SDK's libz).
host_library(
    name = "zlib",
    linkopts = ["-lz"],
)

host_library(
    name = "partition",
    srcs = ["//boot:storage/partition.c"],
    hdrs = [
        "//boot:storage/fat32.h",
        "//boot:storage/partition.h",
    ],
    copts = ["-O2"],
)

host_test(
    name = "partition_test",
    srcs = ["partition_test.cpp"],
    deps = [
        ":partition",
        ":zlib",
    ],
)

host_library(
    name = "fat32",
    srcs = ["//boot:storage/fat32.c"],
    hdrs = ["//boot:storage/fat32.h"],
    copts = ["-O2"],
)

host_test(
    name = "fat32_test",
    srcs = ["fat32_test.cpp"],
    deps = [":fat32"],
)

host_library(
    name = "raw_apfs",
    srcs = [
        "raw_apfs_model.c",
        "//boot:storage/block_backend.h",
        "//boot:storage/raw_apfs.c",
    ],
    hdrs = ["//boot:storage/raw_apfs.h"],
    copts = ["-O1"],
    deps = ["//bazel/testing:c_check"],
)

host_test(
    name = "raw_apfs_test",
    srcs = ["raw_apfs_test.cpp"],
    deps = [":raw_apfs"],
)

host_library(
    name = "sd_reference",
    srcs = ["//boot:storage/sd_reference.c"],
    hdrs = ["//boot:storage/sd_reference.h"],
    copts = ["-O2"],
)

host_test(
    name = "sd_reference_test",
    srcs = ["sd_reference_test.cpp"],
    deps = [
        ":sd_reference",
        ":zlib",
    ],
)

host_library(
    name = "sdmmc_read",
    srcs = [
        "sdmmc_read_model.c",
        "//boot:storage/sdmmc_read.c",
    ],
    hdrs = ["//boot:storage/sdmmc_read.h"],
    copts = ["-O2"],
    deps = ["//bazel/testing:c_check"],
)

host_test(
    name = "sdmmc_read_test",
    srcs = ["sdmmc_read_test.cpp"],
    deps = [":sdmmc_read"],
)
