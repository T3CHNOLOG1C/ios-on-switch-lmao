# What the build derives from the IPSW's members: @ipsw//:<role>, the kind --//ipsw:kind selects (fetched by
# range request; //ipsw). The kind's own pins (the decompressed kernelcache's sha256, ...) are in
# ipsw/pins.bzl, which the rules read through //ipsw:current.

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//bazel/lint:defs.bzl", "lint_files")
load(":defs.bzl", "ipsw_kernelcache", "ipsw_static_trust")
load(":ipsw.bzl", "ipsw_kinds")

package(default_visibility = ["//visibility:public"])

lint_files()

# The original kernelcache, decompressed: what the prelinker takes Apple's kexts from and the ABI checks read.
ipsw_kernelcache(
    name = "kernelcache",
    src = "@ipsw//:kernelcache",
    out = "kernelcache.decompressed",
)

# The static trust cache bundle for the root and the OS cryptex (vendor/unixnu's original-static-system.bundle).
ipsw_static_trust(
    name = "static_system_trust",
    out = "original-static-system.bundle",
    static = "@ipsw//:static_trust_cache",
    system = "@ipsw//:system_cryptex_trust_cache",
)

# The App cryptex's trust cache (an IM4P 'trca'), as the package appends it.
alias(
    name = "app_cryptex_trust_cache",
    actual = "@ipsw//:app_cryptex_trust_cache",
)

# `bazel run //ipsw:pin -- --kind=<build> <ipsw url> <product> <device class>`: pins one IPSW kind's members in
# ipsw/pins.bzl (the others and every kind's derived pins are kept).
py_binary(
    name = "pin",
    srcs = ["pin.py"],
    deps = [":aea"],
)

py_library(
    name = "aea",
    srcs = ["aea.py"],
    deps = ["@switch_pypi//cryptography"],
)

py_binary(
    name = "aea_decrypt",
    srcs = ["aea_decrypt.py"],
)

# Inflates a deflated member's bytes and checks the content against its pin (ipsw_inflate runs it).
py_binary(
    name = "inflate",
    srcs = ["inflate.py"],
)

# --//ipsw:kind (default pins.bzl's DEFAULT_KIND), a config_setting per kind (//ipsw:<kind>), the deflated
# members inflated (//ipsw:<kind>_<role>, what @ipsw//:<role> selects), :current (the kind's IpswInfo).
ipsw_kinds()
