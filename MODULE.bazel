"""ioswitch: iPadOS 17.7.11 (21H461, iPad7,1) on the Nintendo Switch OLED.

Everything the build reads is pinned here (or in a .bzl this file loads) by version and sha256, except the one
declared host input: Xcode and its SDKs (Apple's licence forbids redistributing them), which bazel/host checks
against the pins in bazel/host/xcode.bzl.
"""

module(name = "ioswitch")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_python", version = "2.4.6")

# GoogleTest for the host tests (//bazel/testing:defs.bzl host_test), test-only: nothing shipped links it.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)

# libjpeg-turbo, the reference decoder TegraNVJPG's host test compares its parser and planes against (test-only).
bazel_dep(name = "libjpeg_turbo", version = "3.1.3.bcr.6", dev_dependency = True)

# --- Python: the build's tools and tests run on this interpreter, never the host's ------------------------------
# No implicit __init__.py in runfiles: tools/ is a namespace package (PEP 420), imported as tools.install etc.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "ioswitch_pypi",
    python_version = "3.13",
    requirements_lock = "//bazel/python:requirements_lock.txt",
)
use_repo(pip, "ioswitch_pypi")

# uv 0.13.0 (the version the editor uses), only for `bazel run //bazel/python:requirements.update`, which locks
# bazel/python/requirements.in into requirements_lock.txt. Pinned by URL and sha256 rather than uv's release manifest.
uv = use_extension("@rules_python//python/uv:uv.bzl", "uv", dev_dependency = True)
uv.configure(
    platform = "aarch64-apple-darwin",
    sha256 = "a9c1b29002cf3c83f07fa9cd8a887a3be0107d90e23189721221e7257db8e3d6",
    urls = ["https://github.com/astral-sh/uv/releases/download/0.13.0/uv-aarch64-apple-darwin.tar.gz"],
    version = "0.13.0",
)

# --- Lint and format tools (//bazel/lint): release binaries pinned in bazel/lint/tools.bzl ----------------------
lint_tools = use_extension("//bazel/lint:tools.bzl", "lint_tools")
use_repo(lint_tools, "buildifier", "dprint", "dprint_plugin_json", "dprint_plugin_toml", "ruff", "rumdl", "shellcheck", "shfmt")

# --- LLVM 23.1.4 (the Homebrew version the CMake flow used): ld.lld/objcopy/readelf/objdump for the loader, llvm-objcopy
# for late kernel objects, clang-format/clang-tidy for lint. Only those binaries of the release are extracted. --------
llvm_tools = use_repo_rule("//bazel/llvm:llvm.bzl", "llvm_tools")

llvm_tools(name = "llvm")

bazel_dep(name = "rules_rust", version = "0.75.0")

# Two changes to rules_rust (bazel/rust/rules_rust.patch): a crate whose rustc_flags carry its own -Cmetadata keeps that
# value alone, as its output hash too, so m2v's crates keep cargo's symbol names and NAK's meson's; and a crate given
# -Cincremental=<base> (bazel/rust/defs.bzl, the debug profile) compiles incrementally, unsandboxed, one session per
# configuration.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//bazel/rust:rules_rust.patch"],
)

# --- C/C++ toolchains, by target platform (bazel/platforms): the kernel's Apple clang with XNU's recipes ----------
register_toolchains("//bazel/toolchains/kernel:toolchain")

# iOS user space and the macOS twins of iOS code (NVK's): Xcode's Apple clang, no flags of its own
# (bazel/toolchains/apple). Before any host toolchain; they need //bazel/platforms:user, which the host platform lacks.
register_toolchains(
    "//bazel/toolchains/apple:ios",
    "//bazel/toolchains/apple:macos",
)

# --- The declared host input: Xcode (pinned version + SDK digests) ---------------------------------------------
xcode_host = use_repo_rule("//bazel/host:xcode.bzl", "xcode_host")

xcode_host(name = "xcode")

# The checked-in pins (bazel/pinned), each copied in through Bazel's sha256 check (bazel/host/files.bzl).
pinned_files = use_repo_rule("//bazel/host:files.bzl", "pinned_files")

pinned_files(
    name = "pinned",
    sums = "//bazel/pinned:SHA256SUMS",
)

# --- Apple open source the kernel is built with (apple-oss-distributions tags), plus our patches ------------------
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_SOURCE_BUILD = 'exports_files(glob(["**"]))\n\nfilegroup(name = "all", srcs = glob(["**"]), visibility = ["//visibility:public"])\n'

# XNU itself is vendored (kernel/xnu-10063.141.1, with our changes as commits). The tag as Apple publishes it, for its
# lldb macros (deploy's kcdata decoding).
http_archive(
    name = "xnu_base",
    build_file_content = _SOURCE_BUILD,
    sha256 = "ffdc143cbf4c57dac48e7ad6367ab492c6c4180e5698cb2d68e87eaf1781bc48",
    strip_prefix = "xnu-xnu-10063.141.1",
    urls = ["https://github.com/apple-oss-distributions/xnu/archive/refs/tags/xnu-10063.141.1.tar.gz"],
)

http_archive(
    name = "libplatform",
    build_file_content = _SOURCE_BUILD,
    sha256 = "5de737c41efa455b1514af6e4fac87a5479e466b384dedf9dfcad25b0fb0388e",
    strip_prefix = "libplatform-libplatform-316.100.10",
    urls = ["https://github.com/apple-oss-distributions/libplatform/archive/refs/tags/libplatform-316.100.10.tar.gz"],
)

http_archive(
    name = "libdispatch",
    build_file_content = _SOURCE_BUILD,
    sha256 = "97e3cac286e4d521594d4822767cd3b32b18a8ba8841c288451e786f69134c80",
    strip_prefix = "libdispatch-libdispatch-1477.100.9",
    urls = ["https://github.com/apple-oss-distributions/libdispatch/archive/refs/tags/libdispatch-1477.100.9.tar.gz"],
)

http_archive(
    name = "availability_versions",
    build_file_content = _SOURCE_BUILD,
    sha256 = "4aea449803bd26bf7af37688f6defde48c897d03aa5e22abfda4accc97ced322",
    strip_prefix = "AvailabilityVersions-AvailabilityVersions-141.1",
    urls = ["https://github.com/apple-oss-distributions/AvailabilityVersions/archive/refs/tags/AvailabilityVersions-141.1.tar.gz"],
)

http_archive(
    name = "libpthread",
    build_file_content = _SOURCE_BUILD,
    patch_args = ["-p1"],
    patches = ["//out/native-a57/root-v1/tree/patches:libpthread/explicit-kernel-address.patch"],
    sha256 = "82f9ec53344f80b164535b47a12bac05eec6ffb78130ea0f016a9cb2e904aa04",
    strip_prefix = "libpthread-libpthread-519.120.4",
    urls = ["https://github.com/apple-oss-distributions/libpthread/archive/refs/tags/libpthread-519.120.4.tar.gz"],
)

http_archive(
    name = "iostoragefamily",
    build_file_content = _SOURCE_BUILD,
    sha256 = "2dfe356b50641d2acc0298c557fa310d8c2ba99aa44e097872e567f77d599e60",
    strip_prefix = "IOStorageFamily-IOStorageFamily-315",
    urls = ["https://github.com/apple-oss-distributions/IOStorageFamily/archive/refs/tags/IOStorageFamily-315.tar.gz"],
)

# Apple's corecrypto 2023 source release (the developer.apple.com download), as mirrored at this commit.
http_archive(
    name = "corecrypto",
    build_file_content = _SOURCE_BUILD,
    sha256 = "fd04cb46cb733fdd8e6334702081a33b202ae7645140f59fa55b7d47de7e688f",
    strip_prefix = "corecrypto-2023-11fba65b12d8830630e248dfa8344caf8b065f26",
    urls = ["https://github.com/ONLYA/corecrypto-2023/archive/11fba65b12d8830630e248dfa8344caf8b065f26.tar.gz"],
)

# lz4 1.10.0 (the CLI the boot package compresses the kernel window with: lz4 -12; built from source by //tools:lz4).
http_archive(
    name = "lz4",
    build_file_content = _SOURCE_BUILD,
    sha256 = "537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b",
    strip_prefix = "lz4-1.10.0",
    urls = ["https://github.com/lz4/lz4/releases/download/v1.10.0/lz4-1.10.0.tar.gz"],
)

# --- The IPSW: per IPSW kind (bazel/ipsw/pins.bzl, --//bazel/ipsw:kind), only the members the build and the SD install
# read, fetched by HTTP range request into the repository cache (`bazel run //bazel/ipsw:pin` to pin a kind). The
# build names them @ipsw//:<role>, the selected kind's. --------------------------------------------------------------
ipsw = use_extension("//bazel/ipsw:ipsw.bzl", "ipsw")
use_repo(ipsw, "ipsw")

# --- GPU (owned by gpu/) -----------------------------------------------------------------------------------------
# Rust 1.98.0 (the bridge's `cargo +1.98.0`), with the iOS standard library: the Metal bridge is built by this
# toolchain's cargo, offline, inside a Bazel action (gpu/defs.bzl). rules_rust pins the dist archives by sha256.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "aarch64-apple-ios",
        "aarch64-apple-darwin",
    ],
    # rustfmt from the same release (//:format, //:format_test), not rules_rust's default nightly.
    rustfmt_version = "1.98.0",
    # One rustc per value of //bazel/rust:toolchain_version (bazel/rust/BUILD.bazel): this one by default.
    target_settings = ["//bazel/rust:toolchain_1.98.0"],
    versions = ["1.98.0"],
)

# Rust 1.96.1, NVK's (NAK and NIL as Mesa built them: gpu/nvk), for the targets that transition
# //bazel/rust:toolchain_version to it. The dist archives are the ones @nvk_rust pins (one repository cache entry each).
rust.repository_set(
    name = "rust_1_96_1",
    edition = "2021",
    exec_triple = "aarch64-apple-darwin",
    rustfmt_version = "1.96.1",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    target_settings = ["//bazel/rust:toolchain_1.96.1"],
    target_triple = "aarch64-apple-darwin",
    versions = ["1.96.1"],
)
rust.repository_set(
    name = "rust_1_96_1",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:ios",
    ],
    target_triple = "aarch64-apple-ios",
)
use_repo(
    rust,
    "rust_macos_aarch64__aarch64-apple-darwin__stable_tools",
    "rust_macos_aarch64__aarch64-apple-ios__stable_tools",
    "rust_toolchains",
)

# The crates.io crates of m2v, the Metal bridge and the corpus runner: @rust_crates (crate_universe, pinned by
# bazel/rust/Cargo.lock and crates.lock.json).
include("//bazel/rust:crates.MODULE.bazel")

# The Apple Metal libraries of the IPSW's OS volume, the device's own data and llvm-as (bazel/gpu/deps.bzl). m2v is
# third_party/m2v, its crates.io crates @rust_crates (bazel/rust).
gpu = use_extension("//bazel/gpu:deps.bzl", "gpu")
use_repo(gpu, "gpu_apple_libs", "gpu_device_data", "gpu_llvm_as")

# --- NVK (gpu/nvk): Mesa by commit, built here with meson; its tools pinned (gpu/nvk/repos.bzl) ----------------------
http_archive(
    name = "nvk_ninja",
    build_file_content = 'exports_files(["ninja"], visibility = ["//visibility:public"])',
    sha256 = "c99048673aa765960a99cf10c6ddb9f1fad506099ff0a0e137ad8960a88f321b",
    url = "https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-mac.zip",
)

nvk = use_extension("//gpu/nvk:repos.bzl", "nvk")
use_repo(nvk, "mesa", "mesa_wraps", "nvk_bindgen_src", "nvk_cbindgen_src", "nvk_libclang", "nvk_rust")
