# Version-2 trust cache modules for every tool that builds one (overlay, the GPU bundle, the pretranslated trees).
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

py_library(
    name = "trustcache",
    srcs = ["trustcache.py"],
    imports = ["../.."],
)

py_test(
    name = "trustcache_test",
    srcs = ["trustcache_test.py"],
    deps = [":trustcache"],
)
