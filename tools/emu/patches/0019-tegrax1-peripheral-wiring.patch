diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index 79e2155..a12f99f 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -645,6 +645,7 @@ config ARMSSE
 config TEGRA2
     bool
     select I2C
+    select SSI
     select SDHCI
     select SERIAL_MM
     select LAN9118
@@ -654,4 +655,5 @@ config TEGRA2
     select USB_EHCI_SYSBUS
     select USB_XHCI_SYSBUS
     select FTM3BD56
+    select FTM4CD60
     select FIXEDMEM
diff --git a/hw/arm/tegra2/tegrax1.c b/hw/arm/tegra2/tegrax1.c
index 59b3c63..8de2aac 100644
--- a/hw/arm/tegra2/tegrax1.c
+++ b/hw/arm/tegra2/tegrax1.c
@@ -39,6 +39,7 @@
 #include "hw/loader.h"
 #include "hw/char/serial-mm.h"
 #include "hw/sd/sdhci.h"
+#include "hw/ssi/ssi.h"
 #include "hw/cpu/a9mpcore.h"
 #include "sysemu/reset.h"
 #include "sysemu/sysemu.h"
@@ -1133,11 +1134,26 @@ static void __tegrax1_init(MachineState *machine)
     tegra_spi_devs[2] = tegra_init_obj_simple(TEGRA_SPI3_BASE, DIRQ(INT_SPI_3), "tegra.spi", true);
     tegra_spi_devs[3] = tegra_init_obj_simple(TEGRA_SPI4_BASE, DIRQ(INT_SPI_4), "tegra.spi", true);
 
+    /* The IMU (ICM-42607-P) on SPI4 CS0; its INT2 is GPIO PX2 (port X = 23). */
+    {
+        SSIBus *ssi = (SSIBus *)qdev_get_child_bus(DEVICE(tegra_spi_devs[3]), "ssi");
+        DeviceState *imu = ssi_create_peripheral(ssi, "icm42607p");
+        qdev_connect_gpio_out_named(DEVICE(tegra_spi_devs[3]), "cs", 0, qdev_get_gpio_in_named(imu, SSI_GPIO_CS, 0));
+        qdev_connect_gpio_out_named(imu, "int2", 0, qdev_get_gpio_in(DEVICE(tegra_gpios_dev), 23 * 8 + 2));
+    }
+
     /* QSPI */
     tegra_qspi_dev = tegra_init_dummyio(TEGRA_QSPI_BASE, TEGRA_QSPI_SIZE, "tegra.qspi", true);
 
     /* TouchPanel */
-    tegra_i2c_touch_panel_dev = i2c_slave_create_simple(tegra_i2c_get_bus(tegra_idc3_dev), "ftm3bd56", 0x49);
+    if (tegra_board >= TEGRAX1PLUS_BOARD) {
+        /* The OLED's FTM4CD60; its INT is GPIO PX1 (port X = 23), low while it has events. */
+        tegra_i2c_touch_panel_dev = i2c_slave_create_simple(tegra_i2c_get_bus(tegra_idc3_dev), "ftm4cd60", 0x49);
+        qdev_connect_gpio_out_named(DEVICE(tegra_i2c_touch_panel_dev), "int", 0,
+                                    qdev_get_gpio_in(DEVICE(tegra_gpios_dev), 23 * 8 + 1));
+    } else {
+        tegra_i2c_touch_panel_dev = i2c_slave_create_simple(tegra_i2c_get_bus(tegra_idc3_dev), "ftm3bd56", 0x49);
+    }
 
     /* Tmp451 (Temperature Sensor) */
     tegra_i2c_tmpsensor_dev = i2c_slave_create_simple(tegra_i2c_get_bus(tegra_idc1_dev), "dummyi2c", 0x4C);
