# The boot entry's packaging: package_raw_boot.py (boot-args = COMMAND_LINE, the ADT edits, USB_HOST, ...),
# native_xnu_layout.py, build_native_loader.py, package_native_handoff.py, native_oled_adt.py. //boot:package runs
# them through :boot with declared inputs.
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

py_library(
    name = "packaging",
    srcs = [
        "build_native_loader.py",
        "native_oled_adt.py",
        "native_xnu_layout.py",
        "package_native_handoff.py",
        "package_raw_boot.py",
    ],
    imports = ["."],
)

# //boot:package: the whole boot entry (kernel window in bl33.bin, loader, boot.scr, ADT edits, overlay).
py_binary(
    name = "boot",
    srcs = ["boot.py"],
    deps = [":packaging"],
)

# //boot:adt: the native OLED board's ADT with the pinned /chosen/random-seed.
py_binary(
    name = "adt",
    srcs = ["adt.py"],
    deps = [":packaging"],
)

# Remakes bazel/pinned/overlay/apple-logo~ipad.png (ProgressUI's 1x boot logo) from the OS volume image:
#   bazel run //tools/package:progressui_logo -- <OS volume .dmg> <output .png>
py_binary(
    name = "progressui_logo",
    srcs = ["progressui_logo.py"],
)

# Remakes bazel/pinned/overlay/wallpaper-1x/*.plist (the J120 iPadOS 17 and Lake wallpapers at the 1x screen class)
# from the OS volume image:
#   bazel run //tools/package:wallpaper_1x -- <OS volume .dmg> <output directory>
py_binary(
    name = "wallpaper_1x",
    srcs = ["wallpaper_1x.py"],
)

py_test(
    name = "wallpaper_1x_test",
    srcs = [
        "wallpaper_1x.py",
        "wallpaper_1x_test.py",
    ],
    data = [
        "//bazel/pinned:overlay/wallpaper-1x/7560.Lake_Flat.plist",
        "//bazel/pinned:overlay/wallpaper-1x/7570.iPadOS_17_Flat.plist",
    ],
    imports = ["."],
)

# //boot:snapshot copies a build to out/boot/lkg/<name> (its py_binary lives in boot/).
exports_files(["snapshot.py"])

# The loader's build ID hashes its builder's sources (build_native_loader.py's source_files): //boot:package passes
# them as --source, and the host tests read them.
filegroup(
    name = "sources",
    srcs = glob(["*.py"]),
)
