# The boot entry's packaging steps, one py_binary each: //boot:package (boot/defs.bzl) runs every one as its own
# action, so an edit to one module reruns only the steps that import it.
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

py_library(
    name = "loader_abi",
    srcs = ["loader_abi.py"],
    imports = ["."],
)

py_library(
    name = "uimage",
    srcs = ["uimage.py"],
    imports = ["."],
)

py_library(
    name = "boot_config",
    srcs = ["boot_config.py"],
    imports = ["."],
)

py_library(
    name = "native_xnu_layout",
    srcs = ["native_xnu_layout.py"],
    imports = ["."],
)

py_library(
    name = "native_oled_adt",
    srcs = ["native_oled_adt.py"],
    imports = ["."],
)

py_library(
    name = "kernel_window",
    srcs = ["build_native_loader.py"],
    imports = ["."],
    deps = [
        ":loader_abi",
        ":native_oled_adt",
        ":native_xnu_layout",
    ],
)

py_binary(
    name = "boot_args",
    srcs = ["boot_args.py"],
)

# //boot:adt: the native OLED board's ADT with the pinned /chosen/random-seed.
py_binary(
    name = "adt",
    srcs = ["adt.py"],
    deps = [":native_oled_adt"],
)

py_binary(
    name = "overlay",
    srcs = ["overlay.py"],
    deps = [":boot_config"],
)

py_binary(
    name = "adt_edit",
    srcs = ["adt_edit.py"],
    deps = [
        ":boot_config",
        ":loader_abi",
        ":native_xnu_layout",
    ],
)

py_binary(
    name = "trust",
    srcs = ["trust.py"],
)

py_binary(
    name = "window",
    srcs = ["build_native_loader.py"],
    main = "build_native_loader.py",
    deps = [":kernel_window"],
)

py_binary(
    name = "loader_link",
    srcs = ["loader_link.py"],
    deps = [
        ":boot_script_lib",
        ":loader_abi",
        ":uimage",
    ],
)

py_library(
    name = "boot_script_lib",
    srcs = ["boot_script.py"],
    imports = ["."],
    deps = [
        ":loader_abi",
        ":uimage",
    ],
)

py_binary(
    name = "bl33",
    srcs = ["bl33.py"],
    deps = [
        ":kernel_window",
        ":loader_abi",
    ],
)

py_binary(
    name = "boot_script",
    srcs = ["boot_script.py"],
    deps = [
        ":loader_abi",
        ":uimage",
    ],
)

# Remakes bazel/pinned/overlay/apple-logo~ipad.png (ProgressUI's 1x boot logo) from the OS volume image:
#   bazel run //tools/package:progressui_logo -- <OS volume .dmg> <output .png>
py_binary(
    name = "progressui_logo",
    srcs = ["progressui_logo.py"],
)

# Remakes bazel/pinned/overlay/wallpaper-1x/*.plist (the J120 iPadOS 17 and Lake wallpapers at the 1x screen class)
# from the OS volume image:
#   bazel run //tools/package:wallpaper_1x -- <OS volume .dmg> <output directory>
py_binary(
    name = "wallpaper_1x",
    srcs = ["wallpaper_1x.py"],
)

py_test(
    name = "wallpaper_1x_test",
    srcs = [
        "wallpaper_1x.py",
        "wallpaper_1x_test.py",
    ],
    data = [
        "//bazel/pinned:overlay/wallpaper-1x/7560.Lake_Flat.plist",
        "//bazel/pinned:overlay/wallpaper-1x/7570.iPadOS_17_Flat.plist",
    ],
    imports = ["."],
)

# //boot:snapshot copies a build to ~/Library/Application Support/ioswitch/lkg/<name> (its py_binary lives in boot/).
exports_files(["snapshot.py"])

# The packaging's modules, for the host tests (//tests), which import them.
filegroup(
    name = "sources",
    srcs = glob(["*.py"]),
)
