load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(["*.py"]))

# bazel run //tools/repro:check [-- TARGET...]: two from-scratch builds, every output compared bit for bit.
py_binary(
    name = "check",
    srcs = ["check.py"],
)

# bazel run //tools/repro:equivalence -- <CMake-flow checkout>: the three-layer comparison with the old flow.
py_binary(
    name = "equivalence",
    srcs = ["equivalence.py"],
)

# bazel run //tools/repro:cache_check [-- TARGET...]: a second worktree of this commit, built in a fresh output base,
# must execute nothing (every action a disk-cache hit): action keys do not depend on the checkout's or output base's path.
py_binary(
    name = "cache_check",
    srcs = ["cache_check.py"],
)
