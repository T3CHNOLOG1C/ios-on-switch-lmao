# The GPU bundle's build steps (gpu/defs.bzl runs them as actions).
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//gpu:__subpackages__"])

lint_files()

py_binary(
    name = "xcode_run",
    srcs = ["xcode_run.py"],
)

py_binary(
    name = "bundle",
    srcs = ["bundle.py"],
    deps = ["//tools/trustcache"],
)

py_library(
    name = "nvk_twin",
    srcs = ["nvk_twin.py"],
    visibility = ["//tools/gpu/shaders:__pkg__"],
)

py_binary(
    name = "seed",
    srcs = ["seed.py"],
    deps = [":nvk_twin"],
)

# Runs the pack generator (--generator, the //out/.../TegraGM20BMetal:raw_pack library's rawpack.py) with the twin
# seed.py twin made.
py_binary(
    name = "rawpack",
    srcs = ["rawpack.py"],
    deps = ["//drivers/TegraGM20BMetal:raw_pack"],
)

py_binary(
    name = "raw_stack",
    srcs = ["raw_stack.py"],
)

py_binary(
    name = "assemble",
    srcs = ["assemble.py"],
)
