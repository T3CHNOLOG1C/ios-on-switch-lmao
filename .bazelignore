# Build output, device logs, third-party checkouts and agent scratch that live (untracked) in the working copy: Bazel
# must never glob or walk them (`bazel test //...` would otherwise crawl many GB). Everything the build reads is a
# pinned download, a tracked source, a declared host input or bazel/pinned.
bundles
vendor
out/agent-scratch
out/boot
out/build
out/cmake
out/gpu
out/gpu-artifacts
out/native-apfs-installer-v24
out/native-raw-v24-boot
out/native-single-apfs-trial-v1
out/native-smp-four-layout-v1
out/research-graphics
out/research-native
out/native-media
out/native-a57/root-v1/data-seed
out/native-a57/root-v1/tree/build
out/native-a57/root-v1/tree/.cache
out/native-a57/root-v1/tree/refer
out/native-a57/root-v1/tree/.git-empty-unused
out/switch/device-logs
out/switch/raw-v24-firmware
out/switch/cryptex-trustcaches
.claude
