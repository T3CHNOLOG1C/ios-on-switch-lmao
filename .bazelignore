out/research-native
out/native-media
out/native-a57/root-v1/data-seed
out/native-a57/root-v1/tree/build
out/native-a57/root-v1/tree/.cache
out/native-a57/root-v1/tree/refer
out/native-a57/root-v1/tree/.git-empty-unused
.claude
.git
.agents
# Device photos, logs and install receipts (nothing under out/switch is tracked).
out/switch
