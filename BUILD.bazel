# ioswitch: iPadOS 17.7.11 (21H461, iPad7,1) on the Nintendo Switch OLED. README.md has the whole map.
#
#   bazel build //:boot        the Hekate boot entry (bazel-bin/boot/ioswitch: switchroot/, bootloader/, overlay/)
#   bazel build //:kernel      the prelinked kernel (XNU + drivers + Apple's kexts)
#   bazel build //:gpu         the TegraGM20B Metal bundle, its m2v seed and trust cache
#   bazel test //...           unit tests, pinned-input checks, lint
#   bazel run //deploy:sd -- <disk>      bazel run //deploy:pull_logs -- <disk>      bazel run //install:sd -- <disk>
package(default_visibility = ["//visibility:public"])

alias(
    name = "boot",
    actual = "//boot:package",
)

alias(
    name = "kernel",
    actual = "//out/native-a57/root-v1/tree:kernel",
)

alias(
    name = "gpu",
    actual = "//gpu:bundle",
)
