From df082e9ac9f7fb9338e2e30dac968c1a0f267aea Mon Sep 17 00:00:00 2001
From: r8-webgpu <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 20:16:05 +0000
Subject: [PATCH] nvk: host image copy on Tegra SoCs from Maxwell; copies
 through the client's map, no clean after a read (ioswitch nvk-0006)

---
 src/nouveau/vulkan/nvk_host_copy.c       | 52 ++++++++++++++++--------
 src/nouveau/vulkan/nvk_physical_device.c | 17 +++++++-
 2 files changed, 51 insertions(+), 18 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_host_copy.c b/src/nouveau/vulkan/nvk_host_copy.c
index e4d7ef0d..6a4ea867 100644
--- a/src/nouveau/vulkan/nvk_host_copy.c
+++ b/src/nouveau/vulkan/nvk_host_copy.c
@@ -55,6 +55,12 @@ memcpy2d(void *dst, size_t dst_stride_B,
    }
 }
 
+/* ioswitch: a copy goes through the client's mapping of the memory where it
+ * has one (the runtime maps its blocks whole, for good), and maps it only
+ * where it has none: on nvkmd_darwin each internal map is a kernel mapping of
+ * the whole BO, faulted in page by page, then unmapped. A read cleans nothing
+ * back to the GPU after it.
+ */
 static VkResult
 nvk_image_plane_map(const struct nvk_image_plane *plane,
                     enum nvkmd_mem_map_flags map_flags,
@@ -63,15 +69,20 @@ nvk_image_plane_map(const struct nvk_image_plane *plane,
    struct nvk_device_memory *host_mem = plane->host_mem;
    VkResult result;
 
-   result = nvkmd_mem_map(host_mem->mem, &host_mem->vk.base,
-                          map_flags, NULL, map_out);
-   if (result != VK_SUCCESS)
-      return result;
+   const bool client = host_mem->mem->client_map != NULL;
+   if (client) {
+      *map_out = host_mem->mem->client_map;
+   } else {
+      result = nvkmd_mem_map(host_mem->mem, &host_mem->vk.base,
+                             map_flags, NULL, map_out);
+      if (result != VK_SUCCESS)
+         return result;
+   }
 
    /* TODO: This should be a lot more granular */
-   nvkmd_mem_sync_map_from_gpu(plane->host_mem->mem,
-                               plane->host_offset_B,
-                               plane->nil.size_B);
+   nvkmd_mem_sync_from_gpu(plane->host_mem->mem, client,
+                           plane->host_offset_B,
+                           plane->nil.size_B);
 
    *map_out += plane->host_offset_B;
 
@@ -79,14 +90,23 @@ nvk_image_plane_map(const struct nvk_image_plane *plane,
 }
 
 static void
-nvk_image_plane_unmap(const struct nvk_image_plane *plane)
+nvk_image_plane_unmap(const struct nvk_image_plane *plane,
+                      enum nvkmd_mem_map_flags map_flags)
 {
+   struct nvkmd_mem *mem = plane->host_mem->mem;
+   /* The client map is checked again: it is the same as at the map, which
+    * the client keeps for as long as it copies (its contract).
+    */
+   const bool client = mem->client_map != NULL;
+
    /* TODO: This should be a lot more granular */
-   nvkmd_mem_sync_map_to_gpu(plane->host_mem->mem,
-                             plane->host_offset_B,
-                             plane->nil.size_B);
+   if (map_flags & NVKMD_MEM_MAP_WR) {
+      nvkmd_mem_sync_to_gpu(mem, client, plane->host_offset_B,
+                            plane->nil.size_B);
+   }
 
-   nvkmd_mem_unmap(plane->host_mem->mem, 0);
+   if (!client)
+      nvkmd_mem_unmap(mem, 0);
 }
 
 static VkResult
@@ -179,7 +199,7 @@ nvk_copy_memory_to_image(struct nvk_image *dst,
       }
    }
 
-   nvk_image_plane_unmap(dst_plane);
+   nvk_image_plane_unmap(dst_plane, NVKMD_MEM_MAP_WR);
 
    return VK_SUCCESS;
 }
@@ -305,7 +325,7 @@ nvk_copy_image_to_memory(struct nvk_image *src,
       }
    }
 
-   nvk_image_plane_unmap(src_plane);
+   nvk_image_plane_unmap(src_plane, NVKMD_MEM_MAP_RD);
 
    return VK_SUCCESS;
 }
@@ -540,8 +560,8 @@ nvk_copy_image_to_image(struct nvk_device *dev,
       vk_free(&dev->vk.alloc, tmp_mem);
    }
 
-   nvk_image_plane_unmap(src_img_plane);
-   nvk_image_plane_unmap(dst_img_plane);
+   nvk_image_plane_unmap(src_img_plane, NVKMD_MEM_MAP_RD);
+   nvk_image_plane_unmap(dst_img_plane, NVKMD_MEM_MAP_WR);
 
    return VK_SUCCESS;
 }
diff --git a/src/nouveau/vulkan/nvk_physical_device.c b/src/nouveau/vulkan/nvk_physical_device.c
index f3c66f08..920b3655 100644
--- a/src/nouveau/vulkan/nvk_physical_device.c
+++ b/src/nouveau/vulkan/nvk_physical_device.c
@@ -85,6 +85,16 @@ nvk_get_vk_version(const struct nv_device_info *info)
    return VK_MAKE_VERSION(1, 4, VK_HEADER_VERSION);
 }
 
+/* VK_EXT_host_image_copy: Turing+, and Tegra SoCs from Maxwell (ioswitch,
+ * the GM20B: getBytes of a Shared texture without waiting for the queue).
+ */
+static bool
+nvk_has_host_image_copy(const struct nv_device_info *info)
+{
+   return info->cls_eng3d >= TURING_A ||
+          (info->type == NV_DEVICE_TYPE_SOC && info->cls_eng3d >= MAXWELL_A);
+}
+
 static bool
 nvk_is_conformant(const struct nv_device_info *info)
 {
@@ -264,7 +274,10 @@ nvk_get_device_extensions(const struct nvk_instance *instance,
       .EXT_graphics_pipeline_library = true,
       .EXT_hdr_metadata = true,
       .EXT_host_query_reset = true,
-      .EXT_host_image_copy = info->cls_eng3d >= TURING_A,
+      /* ioswitch: and on Tegra SoCs from Maxwell (nil copies their TegraColor
+       * GOBs, the K1-to-Parker sector layout of the block-linear modifier).
+       */
+      .EXT_host_image_copy = nvk_has_host_image_copy(info),
       .EXT_image_2d_view_of_3d = true,
       .EXT_image_robustness = true,
       .EXT_image_sliced_view_of_3d = true,
@@ -506,7 +519,7 @@ nvk_get_device_features(const struct nv_device_info *info,
       .maintenance5 = true,
       .maintenance6 = true,
       .pipelineRobustness = true,
-      .hostImageCopy = info->cls_eng3d >= TURING_A,
+      .hostImageCopy = nvk_has_host_image_copy(info),
       .pushDescriptor = true,
 
       /* VK_KHR_copy_memory_indirect */
-- 
