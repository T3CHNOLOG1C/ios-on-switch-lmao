# Host-side unit tests of the boot chain's native code (native/loader, native/handoff, native/storage, compiled with
# Xcode's clang for the host and driven through ctypes) and of the packaging (tools/package).
#
#   bazel test //tests/...
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

lint_files()

TESTS = glob(["test_*.py"], allow_empty = True)

[py_test(
    name = t[:-3],
    size = "medium",
    srcs = TESTS,
    data = glob(
        [
            "*.c",
            "*.cpp",
            "*.h",
        ],
        allow_empty = True,
    ) + [
        "//native:all_sources",
        "//kernel:lint_sources",
        "//out/native-a57/root-v1/tree/patches:xnu-ioswitch.diff",
        "//tools/package:sources",
        "//tools:lz4",
        "//boot:raw-v24-boot.cmd",
        "//bazel/pinned:firmware/bl33.bin",
        "@llvm//:bin/ld.lld",
        "@llvm//:bin/lld",
        "@llvm//:bin/llvm-objcopy",
        "@llvm//:bin/llvm-objdump",
        "@llvm//:bin/llvm-readelf",
        "@llvm//:bin/llvm-readobj",
    ],
    # The tools the tests run, from the build's own pins (runfiles paths, relative to the test's working directory),
    # then the system's: lz4 1.10.0, LLVM 23.1.4's ld.lld/llvm-objcopy/..., Xcode's clang through /usr/bin.
    env = {"PATH": "tools:../+llvm_tools+llvm/bin:/usr/bin:/bin:/usr/sbin:/sbin"},
    imports = [".."],
    main = t,
    tags = ["requires-darwin"],
) for t in TESTS]
