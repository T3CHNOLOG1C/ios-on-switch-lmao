load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//kernel/rules:defs.bzl", "xnu_lint_files", "xnu_recorder", "xnu_sources", "xnu_unrecorded")

package(default_visibility = ["//visibility:public"])

xnu_lint_files()

xnu_sources(
    name = "srcs",
    tags = ["manual"],
)

xnu_recorder(
    base_sources = {
        "availability": "@availability_versions_157_2//:availability",
        "libdispatch": "@libdispatch_1542_100_32//:LICENSE",
        "libplatform": "@libplatform_375_120_2//:LICENSE",
    },
    darwin = "25.5.0",
    ios_min = "26.0",
    version = "12377.121.6",
)

xnu_unrecorded(
    name = "sdk",
    reason = "no tables recorded yet: bazel run :update_tables",
    tags = ["manual"],
)

# XNU's make compiles a64x from inside the tree, so bsd/kern/a64x/ is a copy of //translate/arm64e's core.
[
    diff_test(
        name = "a64x_copy_{}_test".format(name.replace(".", "_")),
        file1 = "bsd/kern/a64x/" + name,
        file2 = "//translate/arm64e:a64x/" + name,
    )
    for name in [
        "a64x.h",
        "a64x_classify.c",
        "a64x_fp16.h",
        "a64x_image.c",
        "a64x_rewrite.c",
        "a64x_vlive.h",
    ]
]
