# The kernel: which XNU it is built from, and (from the layout move on) the kernelcache's archives, link and prelink.

package(default_visibility = ["//visibility:public"])

lint_files()

# The XNU the kernel is built from: kernel/xnu-<version>/. Code that differs per version uses #if XNU_<version> (the
# kernel toolchain defines it from this setting); drivers depend on :sdk, never on one XNU's labels.
string_flag(
    name = "xnu_version",
    build_setting_default = "10063.141.1",
    values = ["10063.141.1"],
)

config_setting(
    name = "xnu_10063_141_1",
    flag_values = {":xnu_version": "10063.141.1"},
)

# The selected XNU's SDK for the kernel's compiles (headers and the paths the kernel toolchain names).
alias(
    name = "sdk",
    actual = select({":xnu_10063_141_1": "//kernel/xnu-10063.141.1:sdk"}),
)

exports_files(["build-options.json"])

# Headers every driver may include besides its own (bazel/kernel/kernel.bzl EXTRA_HEADERS).
cc_library(
    name = "hdrs_extra",
    hdrs = ["//drivers/NativeMetal:OriginalAcceleratorABI.h"],
    tags = ["kernel"],
    target_compatible_with = ["//bazel/platforms:kernel"],
)

