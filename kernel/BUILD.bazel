# --- The kernel SDK root (the CMake flow's .cache/fakeroot) -------------------------------------------------------
# kernel/xnu-<version>:sdkroot (XNU's installhdrs as Bazel actions, one file each) as one directory, for the tools
# that still take a directory (firehose, the XNU make build, corecrypto, libpthread).
xnu_tree(
    name = "fakeroot_headers",
    src = "//kernel/xnu-10063.141.1:sdkroot",
    out = ".cache/fakeroot-headers",
)

kernel_firehose(
    name = "fakeroot",
    sdkroot = ":fakeroot_headers",
    xnu = "//kernel/xnu-10063.141.1:srcs",
)

# --- XNU ------------------------------------------------------------------------------------------------------------
# The kernel's XNU options are the smp pass's build-options.json (its archive paths are unused: kernel_link names the
# archives built here).
xnu_build(
    name = "xnu",
    headers = [
        "//diagnostics/ioswitch:headers",
        "//drivers/NativeIOSwitchBlock:headers",
        "//kits/VerifiedRoot:headers",
    ],
    options = "//kernel:build-options.json",
    sdkroot = ":fakeroot",
    xnu = "//kernel/xnu-10063.141.1:srcs",
)

# What the kernel's code compiles against: //kernel:sdk (kernel/xnu-<version>, every header its own file).

# Generated headers the drivers' flags name ({build}/<dir>): built once, in the configuration that asks for the kernel.
outer_headers(
    name = "gen_storage_abi",
    srcs = [":storage_abi"],
)

outer_headers(
    name = "gen_native_data_seed",
    srcs = [":native_data_seed_header"],
)

outer_headers(
    name = "gen_pinned_headers",
    srcs = [":pinned_headers"],
)

# --- Generated and pinned inputs, where the CMake flow's -I flags expected them (tree/build/<dir>) -----------------
stage_files(
    name = "pinned_headers",
    files = {
        "//bazel/pinned:kernel/native-legacy-display/OriginalLegacyFramebufferABI.h": "build/native-legacy-display/OriginalLegacyFramebufferABI.h",
        "//bazel/pinned:kernel/native-hid-input/OriginalHidDeviceABI.h": "build/native-hid-input/OriginalHidDeviceABI.h",
        "//bazel/pinned:kernel/sheng-platform-power/OriginalPMGRABI.h": "build/sheng-platform-power/OriginalPMGRABI.h",
        "//bazel/pinned:kernel/sheng-platform-power/GuardedPMGRSlots.inc": "build/sheng-platform-power/GuardedPMGRSlots.inc",
    },
)

tool_output(
    name = "storage_abi",
    srcs = ["@iostoragefamily//:all"],
    args = [
        "--xcode-env={xcode_env}",
        "--source=external/+http_archive+iostoragefamily",
        "--out={out}",
    ],
    message = "IOStorageFamily-315 headers (storage-abi)",
    out_dirs = ["build/storage-abi/include"],
    tool = "storage_abi.py",
)

# NativeRamBlock's seed pins: a pure function of the pinned seed and its volume UUID (XNU_OWNER_DATA_VOLUME_UUID).
tool_output(
    name = "native_data_seed_header",
    srcs = ["//bazel/pinned:data-seed/data-v10.dbr"],
    outs = ["build/native-ram-block/NativeDataSeed.h"],
    args = [
        "$(location //bazel/pinned:data-seed/data-v10.dbr)",
        "CCD5A1A2-2FDC-4B25-B322-AE1722871BC9",
        "{out}",
    ],
    tool = "data_seed.py",
)

# --- Corecrypto, libpthread (Apple sources, built against this XNU) ---------------------------------------------------
# XNU's symbol names: what corecrypto namespaces against. A change that adds or removes no XNU symbol leaves the list,
# and so corecrypto's archive, alone.
tool_output(
    name = "xnu_symbols",
    srcs = [
        "//kernel/xnu-10063.141.1/config:all_alias_exp",
        "//kernel/xnu-10063.141.1/config:link_symbols",
        "//kernel/xnu-10063.141.1/config:link_symbols_list",
    ],
    outs = ["build/xnu/kernel-names.txt"],
    args = [
        "--names-list=$(execpath //kernel/xnu-10063.141.1/config:link_symbols_list)",
        "--aliases=$(execpath //kernel/xnu-10063.141.1/config:all_alias_exp)",
        "--out={out}",
    ],
    message = "Listing XNU's symbol names",
    tool = "xnu_symbols.py",
)

tool_output(
    name = "corecrypto",
    srcs = [
        ":fakeroot",
        ":xnu_symbols",
        "@corecrypto//:all",
    ],
    outs = [
        "build/corecrypto-2023/libcorecrypto_kernel_noasm-namespaced.a",
        "build/corecrypto-2023/namespace.h",
    ],
    args = [
        "--xcode-env={xcode_env}",
        "--source=external/+http_archive+corecrypto",
        "--sdkroot=$(location :fakeroot)",
        "--kernel-names=$(location :xnu_symbols)",
        "--out={out0}",
        "--namespace-header={out1}",
        "--path-root={path_root}",
    ],
    message = "Compiling corecrypto 2023 for the kernel (plain, then namespaced)",
    mnemonic = "KernelCorecrypto",
    tool = "corecrypto.py",
)

tool_output(
    name = "libpthread",
    srcs = [
        ":fakeroot",
        ":xnu",
        "@libpthread//:all",
        "//kernel/xnu-10063.141.1:srcs",
    ],
    outs = [
        "build/libpthread-kernel/libpthread_kernel.a",
        "build/libpthread-kernel/source_pthread_bootstrap.o",
    ],
    args = [
        "--xcode-env={xcode_env}",
        "--source=external/+http_archive+libpthread",
        "--xnu=kernel/xnu-10063.141.1",
        "--sdkroot=$(location :fakeroot)",
        "--objroot=$(execpath :xnu)",
        "--out={out0}",
        "--bootstrap-out={out1}",
        "--path-root={path_root}",
        "--bin-dir={bin_dir}",
    ],
    message = "Compiling libpthread-519.120.4's kernel component",
    mnemonic = "KernelLibpthread",
    tool = "libpthread.py",
)

