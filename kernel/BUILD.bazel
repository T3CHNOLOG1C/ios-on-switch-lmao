# --- Prelink: Apple's original kexts (the V20 roots, plus every driver's prelink list) --------------------------------
tool_output(
    name = "dma_prelink_report",
    srcs = ["//bazel/pinned:prelink/dma-kernel.json.xz"],
    outs = ["build/prelink/dma-kernel.json"],
    args = [
        "$(location //bazel/pinned:prelink/dma-kernel.json.xz)",
        "{out}",
        "012162a73b3cb2c8306e7e0a98bae2bdfb4f6cf91d7698feac787939d0c5ffd0",
    ],
    tool = "unxz.py",
)

kernel_prelink(
    name = "kernel",
    base_roots = [
        "com.apple.driver.AppleMobileFileIntegrity",
        "com.apple.filesystems.apfs",
        "com.apple.security.sandbox",
        "com.apple.AppleFSCompression.AppleFSCompressionTypeZlib",
        "com.apple.iokit.IOMobileGraphicsFamily",
        "com.apple.iokit.IOSurface",
        "com.apple.iokit.IOHIDFamily",
        "com.apple.driver.DiskImages",
        "com.apple.driver.DiskImages.FileBackingStore",
        "com.apple.driver.DiskImages.KernelBacked",
        "com.apple.driver.DiskImages.ReadWriteDiskImage",
    ],
    early_security_init = ["com.apple.driver.AppleMobileFileIntegrity=0xfffffff005ab4ae0"],
    inherit_report = ":dma_prelink_report",
    kernel = ":kernel_unprelinked",
    previous = "//bazel/pinned:prelink/dma-prelink.json",
    slide = "-0x1000000",
)
