    name = "kernel_unprelinked",
    inputs = [
        ":corecrypto",
        ":libArmDTPlatform",
        ":libArmCpu",
        ":libNativeLegacyDisplay",
        ":libNativeAES",
        ":libNativeIOSwitchBlockDevice",
        "//drivers/NativeRamBlock:NativeRamBlock",
