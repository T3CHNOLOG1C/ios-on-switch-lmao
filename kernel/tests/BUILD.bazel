# XNU code ioswitch changes, compiled for the host from the vendored kernel/xnu-10063.141.1 (our changes included) and
# run against the code it replaced:
#   xnu_console_wide_test    video_console.c's rotated text console's 16-byte LDP/STP paths (r9-preboot round 3) give
#                            the same pixels as the 32-bit loops they replaced (arm64 inline assembly: arm64 hosts)
#   xnu_memcmp_test          osfmk/arm64/ioswitch_memcmp.h's word-at-a-time memcmp/bcmp (r17-launch) against the byte
#                            loops, exhaustively to 80 bytes at every alignment and over random inputs, guard pages
#                            after both buffers
#   xnu_memcmp_source_test   subrs.c uses it on arm64 only, through the two bodies the harness copies
#   xnu_zero_fill_around_test  vm_fault.c's ioswitch_zero_fill_around (r17-faults) enters exactly the absent pages of
#                            the faulting page's 16 KiB group in its map entry and VM object, and nothing outside the
#                            plain case, against a model of the object and pmap
#
#   bazel test //kernel/tests:all
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

# --- video_console.c's wide helpers -----------------------------------------------------------------------------------
# helpers.inc: video_console.c from "static inline boolean_t\nvc_rotate3_wide(" up to "static void\nvc_clear_screen(".
genrule(
    name = "console_helpers",
    srcs = ["//kernel/xnu-10063.141.1/osfmk:console/video_console.c"],
    outs = ["helpers.inc"],
    cmd = """awk '
        on && prev == "static void" && $$0 ~ /^vc_clear_screen\\(/ { done = 1; exit }
        on { print prev }
        !on && prev == "static inline boolean_t" && $$0 ~ /^vc_rotate3_wide\\(/ { on = 1; print prev }
        { prev = $$0 }
        END { if (!done) exit 1 }
    ' $< > $@""",
)

host_library(
    name = "console_wide",
    srcs = [
        "helpers.inc",
        "xnu_console_wide_harness.c",
    ],
    copts = ["-O2"],
    defines = ["main=xnu_console_wide_main"],
    includes = ["."],
)

host_test(
    name = "xnu_console_wide_test",
    srcs = ["xnu_console_wide_test.cpp"],
    target_compatible_with = ["@platforms//cpu:arm64"],
    deps = [":console_wide"],
)

# --- ioswitch_memcmp.h ----------------------------------------------------------------------------------------------
copy_file(
    name = "ioswitch_memcmp",
    src = "//kernel/xnu-10063.141.1/osfmk:arm64/ioswitch_memcmp.h",
    out = "ioswitch_memcmp.h",
)

# UBSan only (ASan's own memcmp interceptors are not what is measured; the guard pages catch over-reads), -O2 as XNU.
host_library(
    name = "memcmp",
    srcs = [
        "ioswitch_memcmp.h",
        "xnu_memcmp_harness.c",
    ],
    hdrs = ["xnu_memcmp_harness.h"],
    copts = [
        "-O2",
        "-fsanitize=undefined",
        "-fno-sanitize-recover=all",
    ],
    includes = ["."],
    linkopts = ["-fsanitize=undefined"],
    sanitize = False,
)

host_test(
    name = "xnu_memcmp_test",
    srcs = ["xnu_memcmp_test.cpp"],
    copts = ["-fsanitize=undefined"],
    sanitize = False,
    deps = [":memcmp"],
)

host_test(
    name = "xnu_memcmp_source_test",
    srcs = ["xnu_memcmp_source_test.cpp"],
    data = [
        "xnu_memcmp_harness.c",
        "//kernel/xnu-10063.141.1/osfmk:device/subrs.c",
        "@xnu_base//:osfmk/device/subrs.c",
    ],
    defines = [
        'SUBRS_PATCHED=\\"$(rootpath //kernel/xnu-10063.141.1/osfmk:device/subrs.c)\\"',
        'SUBRS_BASE=\\"$(rootpath @xnu_base//:osfmk/device/subrs.c)\\"',
    ],
)

# --- vm_fault.c's ioswitch_zero_fill_around -----------------------------------------------------------------------------
# fault_around.inc: vm_fault.c from "#ifndef IOSWITCH_ZERO_FILL_AROUND" up to "uint64_t vm_fault_resilient_media_initiate".
genrule(
    name = "fault_around",
    srcs = ["//kernel/xnu-10063.141.1/osfmk:vm/vm_fault.c"],
    outs = ["fault_around.inc"],
    cmd = """awk '
        /^uint64_t vm_fault_resilient_media_initiate/ { if (on) { done = 1; exit } }
        /^#ifndef IOSWITCH_ZERO_FILL_AROUND/ { on = 1 }
        on { print }
        END { if (!done) exit 1 }
    ' $< > $@""",
)

host_library(
    name = "zero_fill_around",
    srcs = [
        "fault_around.inc",
        "xnu_zero_fill_around_harness.c",
    ],
    copts = [
        "-O1",
        "-Wno-unused-parameter",
    ],
    defines = ["main=xnu_zero_fill_around_main"],
    includes = ["."],
)

host_test(
    name = "xnu_zero_fill_around_test",
    srcs = ["xnu_zero_fill_around_test.cpp"],
    deps = [":zero_fill_around"],
)
