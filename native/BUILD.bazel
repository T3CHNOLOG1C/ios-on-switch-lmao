load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

# The RAM metadata exporter (switchroot/ioswitch/exporter.uimg, pinned in bazel/pinned/firmware): its builder and its
# Cortex-A57 model run, against the pinned bl33.bin (its host test: //native/storage/firmware_export/test).
#   bazel run //native:firmware_export -- --output <dir under out/>
py_binary(
    name = "firmware_export",
    srcs = ["storage/firmware_export/build.py"],
    main = "storage/firmware_export/build.py",
)

py_binary(
    name = "firmware_export_model",
    srcs = ["storage/firmware_export/model.py"],
    main = "storage/firmware_export/model.py",
)

filegroup(
    name = "all_sources",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

exports_files(glob(["**"]))
