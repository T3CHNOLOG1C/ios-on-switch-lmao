        "-mgeneral-regs-only",
        "-mstrict-align",
        "-fno-stack-protector",
        "-std=gnu11",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-sign-conversion",
        "-Wno-shorten-64-to-32",
        "-Wno-implicit-int-conversion",
        "-Wno-sign-compare",
        "-Wno-missing-field-initializers",
        "-Wno-gnu-empty-struct",
        "-Wno-zero-length-array",
        "-I",
        "{tree}/drivers/TegraBPMP/shim/include",
