# TegraGM20B: the Tegra X1 GPU (vendored nouveau nvkm under an XNU shim, IOAcceleratorES + AGXDeviceUserClient). Inert
# unless tegra-gpu=<stage>. Apple clang's kernel defaults add -Wsign-conversion, -Wshorten-64-to-32 and
# -Wimplicit-int-conversion; Linux-style nvkm code and its shim trip them over a thousand times.
GPU_C_FLAGS = [
    "-mgeneral-regs-only",
    "-mstrict-align",
    "-fno-stack-protector",
    "-std=gnu11",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wno-unused-parameter",
    "-Wno-sign-conversion",
    "-Wno-shorten-64-to-32",
    "-Wno-implicit-int-conversion",
    "-I",
    "{tree}/drivers/TegraGM20B/shim/include",
    "-I",
    "{tree}/drivers/TegraGM20B/nouveau/include",
    "-I",
    "{tree}/drivers/TegraGM20B/nouveau/include/nvkm",
    "-I",
    "{tree}/drivers/TegraGM20B/nouveau/nvkm",
    "-I",
    "{tree}/drivers/TegraGM20B/nouveau/nvkm/subdev/gsp",
    "-I",
    "{tree}/drivers/TegraGM20B/nouveau",
    "-include",
    "{tree}/drivers/TegraGM20B/shim/include/nvxnu_prelude.h",
]

# The relaxations Linux builds vendored code with (and two Apple clang defaults upstream code trips).
LINUX_RELAXATIONS = [
    "-Wno-pointer-sign",
    "-Wno-sign-compare",
    "-Wno-missing-field-initializers",
    "-Wno-shadow",
    "-Wno-conditional-uninitialized",
]

kernel_driver(
    name = "TegraGM20B_nvkm",
    srcs = [":" + f for f in glob(["drivers/TegraGM20B/nouveau/**/*.c"])],
    c_copts = GPU_C_FLAGS + LINUX_RELAXATIONS,
    c_recipe = ":freestanding_c",
    dir = "drivers/TegraGM20B",
    object_names = "path",
)

kernel_driver(
    name = "TegraGM20B",
    srcs = [
        "shim/linux.c",
        "shim/tegra_shim.c",
        "shim/stubs.c",
        "shim/nvif_nvkm.c",
        "platform.c",
        "gpu.c",
        "shim/xnu_glue.cpp",
        "TegraGM20B.cpp",
        "TegraGM20BUserClient.cpp",
        # Subclasses the original IOAcceleratorES: a late object, run by TegraGM20B.cpp after IOGPUFamily loads.
        "TegraGM20BAccelerator.cpp",
        # GM20B falcon firmware (linux-firmware nvidia/gm20b) by .incbin.
        "firmware.S",
    ],
    c_copts = GPU_C_FLAGS,
    c_recipe = ":freestanding_c",
    copts = [
        "-I",
        "{tree}/drivers/TegraGM20B",
    ],
    late = ["TegraGM20BAccelerator.cpp"],
    object_names = "path",
    # IOAcceleratorES for QuartzCore's 30 s accelerator poll and the GM20B driver.
    prelink = ["com.apple.iokit.IOGPUFamily"],
)

