    "-I",
    "{tree}/drivers/TegraDFLL/linux/include",
    "-include",
    "{tree}/drivers/TegraDFLL/shim/include/tdfll_prelude.h",
]

kernel_driver(
    name = "TegraDFLL_linux",
    srcs = [
        "linux/drivers/clk/tegra/clk-dfll.c",
        "linux/drivers/clk/tegra/clk-tegra124-dfll-fcpu.c",
