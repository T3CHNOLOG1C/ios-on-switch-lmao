# The kernel tree: XNU + our drivers, kits and diagnostics, linked and prelinked into kernel.macho.
#
#   bazel build //:kernel            -> bazel-bin/out/native-a57/root-v1/tree/kernel.macho
#
# Adding a driver: one kernel_driver() call (bazel/kernel/kernel.bzl documents the knobs) and its name in the member list
# of the archive it rides in below. Member order is link order (-force_load). Original kexts a driver needs go in its
# prelink list. Every file here is also exported, e.g. //out/native-a57/root-v1/tree:drivers/TegraGM20B/TegraGM20BABI.h.

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/kernel:inputs.bzl", "tool_output")
load("//bazel/kernel:package.bzl", "ios_binary")
load("//bazel/kernel:kernel.bzl", "PLAIN_ASM", "kernel_archive", "kernel_driver", "kernel_link", "kernel_prelink", "kernel_recipe", "stage_files")
load("//bazel/kernel:xnu.bzl", "kernel_firehose", "kernel_sdkroot", "xnu_build")

package(default_visibility = ["//visibility:public"])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# What //lint formats and checks: our sources and the .clang-format/.clang-tidy files that style them.
filegroup(
    name = "lint_sources",
    srcs = glob(
        [
            "drivers/**",
            "kits/**",
            "diagnostics/ioswitch/**",
            ".clang-format",
            ".clang-tidy",
            ".clang-format-ignore",
            "**/.clang-format",
        ],
        allow_empty = True,
    ),
)

# --- The kernel SDK root (the CMake flow's .cache/fakeroot) -------------------------------------------------------
# Its headers need the patched XNU (its makedefs take XNU_AVAILABILITY_PL/KERNEL_SDKROOT). Unlike the CMake flow's
# fakeroot, which installhdrs filled once and never refreshed, this one follows the patch.
kernel_sdkroot(
    name = "fakeroot_headers",
    out = ".cache/fakeroot-headers",
    xnu = "@xnu//:all",
)

kernel_firehose(
    name = "fakeroot",
    sdkroot = ":fakeroot_headers",
    xnu = "@xnu//:all",
)

# --- XNU ------------------------------------------------------------------------------------------------------------
# The kernel's XNU options are the smp pass's build-options.json (its archive paths are unused: kernel_link names the
# archives built here).
xnu_build(
    name = "xnu",
    headers = glob([
        "diagnostics/**",
        "kits/VerifiedRoot/include/**",
        "drivers/NativeIOSwitchBlock/*.h",
    ]),
    options = "//out/native-a57/root-v1/passes/native-root-smp-v1:build-options.json",
    sdkroot = ":fakeroot",
    xnu = "@xnu//:all",
)

# --- Compile recipes, from XNU's compile records (cmake/XnuRecipes.cmake) ------------------------------------------
kernel_recipe(
    name = "iokit_cxx",
    record = "iokit/DEVELOPMENT/IOPlatformExpert.cpo.json",
    xnu = ":xnu",
)

kernel_recipe(
    name = "iokit_cxx_generic",
    drop = [
        "-mcpu=",
        "-march=",
        "-flto",
    ],
    record = "iokit/DEVELOPMENT/IOPlatformExpert.cpo.json",
    xnu = ":xnu",
)

kernel_recipe(
    name = "osfmk_c",
    record = "osfmk/DEVELOPMENT/arm_init.o.json",
    xnu = ":xnu",
)

kernel_recipe(
    name = "bsd_c",
    keep_warnings = True,
    record = "bsd/DEVELOPMENT/bsd_init.o.json",
    xnu = ":xnu",
)

kernel_recipe(
    name = "mockfs_c",
    drop = [
        "-DMOCKFS=",
        "-UMOCKFS",
    ],
    keep_warnings = True,
    record = "bsd/DEVELOPMENT/vfs_conf.o.json",
    xnu = ":xnu",
)

# The freestanding recipe the vendored Linux code (nvkm, BPMP, DFLL) uses: osfmk's C flags without XNU's include options
# (its headers clash with the shims' Linux-named ones).
kernel_recipe(
    name = "freestanding_c",
    record = "osfmk/DEVELOPMENT/arm_init.o.json",
    strip_includes = True,
    xnu = ":xnu",
)

# --- Generated and pinned inputs, where the CMake flow's -I flags expected them (tree/build/<dir>) -----------------
stage_files(
    name = "pinned_headers",
    files = {
        "//bazel/pinned:kernel/native-legacy-display/OriginalLegacyFramebufferABI.h": "build/native-legacy-display/OriginalLegacyFramebufferABI.h",
        "//bazel/pinned:kernel/native-hid-input/OriginalHidDeviceABI.h": "build/native-hid-input/OriginalHidDeviceABI.h",
        "//bazel/pinned:kernel/sheng-platform-power/OriginalPMGRABI.h": "build/sheng-platform-power/OriginalPMGRABI.h",
        "//bazel/pinned:kernel/sheng-platform-power/GuardedPMGRSlots.inc": "build/sheng-platform-power/GuardedPMGRSlots.inc",
    },
)

tool_output(
    name = "storage_abi",
    srcs = ["@iostoragefamily//:all"],
    out_dirs = ["build/storage-abi/include"],
    args = [
        "--xcode-env={xcode_env}",
        "--source=external/+http_archive+iostoragefamily",
        "--out={out}",
    ],
    message = "IOStorageFamily-315 headers (storage-abi)",
    tool = "storage_abi.py",
)

# NativeRamBlock's seed pins: a pure function of the pinned seed and its volume UUID (XNU_OWNER_DATA_VOLUME_UUID).
tool_output(
    name = "native_data_seed_header",
    srcs = ["//bazel/pinned:data-seed/data-v10.dbr"],
    outs = ["build/native-ram-block/NativeDataSeed.h"],
    args = [
        "$(location //bazel/pinned:data-seed/data-v10.dbr)",
        "CCD5A1A2-2FDC-4B25-B322-AE1722871BC9",
        "{out}",
    ],
    tool = "data_seed.py",
)

# Headers any kernel object may include: every driver/kit/diagnostics header, firmware blobs (.incbin) and the staged
# and generated headers above.
filegroup(
    name = "kernel_headers",
    srcs = glob([
        "drivers/**/*.h",
        "drivers/**/*.hpp",
        "drivers/**/*.inc",
        "drivers/**/*.def",
        "drivers/*/firmware/**",
        "kits/**/*.h",
        "kits/**/*.inc",
        "diagnostics/**/*.h",
        "diagnostics/**/*.inc",
    ], allow_empty = True) + [
        # In the GPU's package (drivers/NativeMetal), included by IOSwitchAccelStub and TegraGM20BAccelerator.
        "//out/native-a57/root-v1/tree/drivers/NativeMetal:OriginalAcceleratorABI.h",
        ":native_data_seed_header",
        ":pinned_headers",
        ":storage_abi",
    ],
)

# --- Corecrypto, libpthread (Apple sources, built against this XNU) ---------------------------------------------------
tool_output(
    name = "corecrypto",
    srcs = [
        ":fakeroot",
        ":xnu",
        "@corecrypto//:all",
    ],
    outs = [
        "build/corecrypto-2023/libcorecrypto_kernel_noasm-namespaced.a",
        "build/corecrypto-2023/namespace.h",
    ],
    args = [
        "--xcode-env={xcode_env}",
        "--source=external/+http_archive+corecrypto",
        "--sdkroot=$(location :fakeroot)",
        "--objroot=$(execpath :xnu)",
        "--out={out0}",
        "--namespace-header={out1}",
        "--path-root={path_root}",
    ],
    message = "Compiling corecrypto 2023 for the kernel (plain, then namespaced)",
    mnemonic = "KernelCorecrypto",
    tool = "corecrypto.py",
)

tool_output(
    name = "libpthread",
    srcs = [
        ":fakeroot",
        ":xnu",
        "@libpthread//:all",
        "@xnu//:all",
    ],
    outs = [
        "build/libpthread-kernel/libpthread_kernel.a",
        "build/libpthread-kernel/source_pthread_bootstrap.o",
    ],
    args = [
        "--xcode-env={xcode_env}",
        "--source=external/+http_archive+libpthread",
        "--xnu=external/+http_archive+xnu",
        "--sdkroot=$(location :fakeroot)",
        "--objroot=$(execpath :xnu)",
        "--out={out0}",
        "--bootstrap-out={out1}",
        "--path-root={path_root}",
        "--bin-dir={bin_dir}",
    ],
    message = "Compiling libpthread-519.120.4's kernel component",
    mnemonic = "KernelLibpthread",
    tool = "libpthread.py",
)

