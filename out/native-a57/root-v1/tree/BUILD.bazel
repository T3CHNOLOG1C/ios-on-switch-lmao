    object_names = "path",
    object_prefix = "tegra-bpmp_",
    stems = {"xnu_glue.cpp": "TegraBPMPGlue"},
)

# TegraDFLL: T210B01 CPU DFLL (closed-loop CL-DVFS), L4T clk-dfll.c + fcpu/cvb/speedo under a Linux shim.
