diff --git a/osfmk/arm64/ioswitch_smp.h b/osfmk/arm64/ioswitch_smp.h
new file mode 100644
index 0000000000000000000000000000000000000000..075003ce33585dca7594f1ba4821a90d7644b8c2
--- /dev/null
+++ b/osfmk/arm64/ioswitch_smp.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef IOSWITCH_SMP_H
+#define IOSWITCH_SMP_H
+/* Shared PSCI physical-entry ABI. Four homogeneous Switch Cortex-A57 cores.
+ * The boot CPU owns control[0..63]; each secondary exclusively owns status[64..127].
+ * Before CPU_ON publish both lines to PoC. After CPU_ON the boot CPU must never
+ * dirty the status line; poll it with invalidate + acquire, not a cached load. */
+#define IOSW_SMP_CORE_COUNT 4
+#define IOSW_SMP_RECORD_BYTES 128
+#define IOSW_SMP_STATUS_OFFSET 64
+#define IOSW_SMP_MAGIC 0x495357534d503031
+#define IOSW_SMP_STAGE_CLEAR 0
+#define IOSW_SMP_STAGE_ENTRY 1
+#define IOSW_SMP_STAGE_EL1 2
+#define IOSW_SMP_STAGE_RESET 3
+#define IOSW_SMP_STAGE_MMU 4
+#define IOSW_SMP_STAGE_C 5
+#define IOSW_SMP_STAGE_FAILED 255
+#define IOSW_SMP_ERROR_CONTROL 1
+#define IOSW_SMP_ERROR_EL 2
+#define IOSW_SMP_ERROR_MPIDR 3
+#define IOSW_SMP_ERROR_SCTLR 4
+#define IOSW_SMP_ERROR_MIDR 5
+#define IOSW_SMP_ERROR_SMPEN 6
+#define IOSW_SMP_ERROR_FREQUENCY 7
+#define IOSW_SMP_ERROR_CNTVOFF 8
+#define IOSW_SMP_ERROR_RESET 9
+#define IOSW_SMP_ERROR_EXCEPTION 256
+#define IOSW_SMP_MAGIC_OFF 0
+#define IOSW_SMP_MPIDR_OFF 8
+#define IOSW_SMP_LOGICAL_OFF 16
+#define IOSW_SMP_CNTFRQ_OFF 24
+#define IOSW_SMP_CNTVOFF_OFF 32
+#define IOSW_SMP_RESET_OFF 40
+#define IOSW_SMP_RESERVED0_OFF 48
+#define IOSW_SMP_RESERVED1_OFF 56
+#define IOSW_SMP_STAGE_OFF 64
+#define IOSW_SMP_ERROR_OFF 72
+#define IOSW_SMP_SEEN_MPIDR_OFF 80
+#define IOSW_SMP_ENTRY_EL_OFF 88
+#define IOSW_SMP_ESR_OFF 96
+#define IOSW_SMP_ELR_OFF 104
+#define IOSW_SMP_FAR_OFF 112
+#define IOSW_SMP_SCTLR_OFF 120
+#ifndef __ASSEMBLER__
+#include <stdint.h>
+#include <stddef.h>
+struct ioswitch_smp_record {
+    uint64_t magic, mpidr, logical, cntfrq, cntvoff, reset_pa, reserved0, reserved1;
+    volatile uint64_t stage, error, seen_mpidr, entry_el, esr, elr, far, sctlr;
+} __attribute__((aligned(64)));
+#ifdef __cplusplus
+static_assert(sizeof(ioswitch_smp_record) == IOSW_SMP_RECORD_BYTES, "SMP record stride");
+static_assert(offsetof(ioswitch_smp_record, stage) == IOSW_SMP_STATUS_OFFSET, "SMP status line");
+extern "C" {
+#else
+_Static_assert(sizeof(struct ioswitch_smp_record) == IOSW_SMP_RECORD_BYTES, "SMP record stride");
+_Static_assert(offsetof(struct ioswitch_smp_record, stage) == IOSW_SMP_STATUS_OFFSET, "SMP status line");
+#endif
+extern struct ioswitch_smp_record ioswitch_secondary_records[IOSW_SMP_CORE_COUNT];
+extern char ioswitch_secondary_records_end[];
+extern char ioswitch_secondary_entry[];
+/* Called only after machine_set_current_thread on this secondary. Installs the
+ * normal XNU KVA vectors and publishes the C-arrival stage. */
+void ioswitch_secondary_vectors_leave(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
+#endif
diff --git a/osfmk/arm64/ioswitch_smp_tables.inc b/osfmk/arm64/ioswitch_smp_tables.inc
new file mode 100644
index 0000000000000000000000000000000000000000..1d8de1ed24ac6939ba86fed873936e98bc81e42d
--- /dev/null
+++ b/osfmk/arm64/ioswitch_smp_tables.inc
@@ -0,0 +1,53 @@
+/* Native XNU pmap scope only. Publish table pages, never mapped device/data leaves. */
+#define IOSW_SMP_MAX_TABLE_PAGES 8192u
+struct iosw_smp_table_walk {
+    pmap_paddr_t ancestors[4];
+    unsigned pages;
+};
+
+int ioswitch_smp_publish_tables(void);
+
+static int
+iosw_smp_clean_table(pmap_paddr_t pa, unsigned level, unsigned entries,
+    const pt_attr_t *attr, struct iosw_smp_table_walk *walk)
+{
+    const unsigned leaf = pt_attr_leaf_level(attr);
+    if (level > leaf || leaf != 3 || !entries || entries > 512 || (pa & 4095) ||
+        !pa_valid(pa) || !pa_valid(pa + 4095) || ++walk->pages > IOSW_SMP_MAX_TABLE_PAGES)
+        return 1;
+    for (unsigned i = pt_attr_root_level(attr); i < level; ++i)
+        if (walk->ancestors[i] == pa) return 1;
+    walk->ancestors[level] = pa;
+    const tt_entry_t *table = (const tt_entry_t *)phystokv(pa);
+    CleanPoC_DcacheRegion((vm_offset_t)table, entries * sizeof(*table));
+    if (level == leaf) return 0;
+    const uint64_t valid = attr->pta_level_info[level].valid_mask;
+    const uint64_t mask = attr->pta_level_info[level].type_mask;
+    const uint64_t block = attr->pta_level_info[level].type_block;
+    for (unsigned i = 0; i < entries; ++i) {
+        const tt_entry_t value = __atomic_load_n(&table[i], __ATOMIC_ACQUIRE);
+        if (!(value & valid) || (value & mask) == block) continue;
+        if ((value & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_TABLE ||
+            iosw_smp_clean_table(value & ARM_TTE_TABLE_MASK, level + 1, 512, attr, walk))
+            return 1;
+    }
+    return 0;
+}
+
+int
+ioswitch_smp_publish_tables(void)
+{
+    const pt_attr_t *attr = pmap_get_pt_attr(kernel_pmap);
+    if (pt_attr_page_size(attr) != 4096 || pt_attr_leaf_level(attr) != 3 ||
+        pt_attr_root_level(attr) > 2 || !cpu_ttep || kernel_pmap->ttep != cpu_ttep)
+        return 1;
+    const vm_size_t bytes = pmap_root_alloc_size(kernel_pmap);
+    if (!bytes || bytes > 4096 || bytes % sizeof(tt_entry_t)) return 1;
+    struct iosw_smp_table_walk walk = { { 0, 0, 0, 0 }, 0 };
+    pmap_lock(kernel_pmap, PMAP_LOCK_SHARED);
+    const int result = iosw_smp_clean_table(cpu_ttep, pt_attr_root_level(attr),
+        (unsigned)(bytes / sizeof(tt_entry_t)), attr, &walk);
+    __builtin_arm_dsb(DSB_SY);
+    pmap_unlock(kernel_pmap, PMAP_LOCK_SHARED);
+    return result;
+}
