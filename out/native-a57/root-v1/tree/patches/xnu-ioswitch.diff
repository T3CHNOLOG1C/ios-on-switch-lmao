+	IORPCMessageMach * reply;
+	uint32_t           sendSize;
+	uint32_t           replySize;
+#ifdef KERNEL
+	IORPCMessage     * kernelContent;
+#endif /* KERNEL */
+};
+typedef struct IORPC IORPC;
+
+enum {
+	kOSClassCanRemote   = 0x00000001,
+};
+
+struct OSClassDescription {
+	uint32_t    descriptionSize;
+
+	char        name[96];
+	char        superName[96];
+
