+#define MACH_PORT_NULL  NULL
+#else /* !KERNEL */
+typedef natural_t mach_port_t;
+#define MACH_PORT_NULL  0
+#endif /* !KERNEL */
+
+typedef natural_t mach_port_name_t;
+
