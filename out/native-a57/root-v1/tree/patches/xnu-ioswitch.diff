+#ifndef _KERN_QUEUE_H_
+#define _KERN_QUEUE_H_
+
+#if DRIVERKIT_FRAMEWORK_INCLUDE
+#include <DriverKit/macro_help.h>
+#else
+#include <mach/mach_types.h>
