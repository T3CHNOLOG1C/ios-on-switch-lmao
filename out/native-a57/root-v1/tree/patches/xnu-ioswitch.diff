+#define sub_iokit_nvme                    err_sub(28)
+#endif
+#define sub_iokit_thunderbolt             err_sub(29)
+#define sub_iokit_graphics_acceleration   err_sub(30)
+#define sub_iokit_keystore                err_sub(31)
