+.macro IOSWITCH_EARLY_MARK stage, color=0xff70ff70
+	cbz x28, 99f
+	cbnz x21, 99f
+	adrp x16, EXT(ioswitch_early_record)@page
+	add x16, x16, EXT(ioswitch_early_record)@pageoff
