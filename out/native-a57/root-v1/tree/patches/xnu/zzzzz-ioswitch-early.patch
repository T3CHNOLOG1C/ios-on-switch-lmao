+	sub x16, x16, #2880
+	subs x18, x18, #1
+	b.ne 98b
+	dsb sy
+99:
+.endmacro
+#else
+.macro IOSWITCH_EARLY_MARK stage, color=0xff70ff70
+.endmacro
+#endif
