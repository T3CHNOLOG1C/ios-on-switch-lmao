+static volatile uint32_t *
+vc_rotate3_pixel(unsigned int x, unsigned int y)
+{
+	return (volatile uint32_t *)(vinfo.v_baseaddr +
+	       (vinfo.v_height - 1 - x) * vinfo.v_rowbytes + y * 4);
+}
