+    for (unsigned i=0; i<iosw_ram.count; ++i) {
+        pmap_paddr_t start=iosw_ram.reserved[i].start, end=iosw_ram.reserved[i].end;
+        if (start >= end) panic("native invalid reservation");
+        if (start < iosw_bootstrap_start && end > iosw_kernel_start) panic("native reservation overlaps kernel");
+        if (start >= iosw_bootstrap_start && start < iosw_bootstrap_limit)
+            iosw_bootstrap_limit = start & ~PAGE_MASK;
+    }
+#endif
+}
