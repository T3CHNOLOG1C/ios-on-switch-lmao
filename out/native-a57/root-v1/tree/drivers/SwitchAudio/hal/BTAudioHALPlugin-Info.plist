<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Shown over /System/Library/Audio/Plug-Ins/HAL/BTAudioHALPlugin.driver/Info.plist by the Data overlay (overlay/manifest.json).
     The audio server (CoreAudio HALS_PlugInManager::LoadPlugIns) defers a plug-in whose loading condition matches no
     IOService, before it loads any code: no service publishes this class, so the Bluetooth plug-in never starts and never
     retries bluetoothd's com.apple.BTAudioHALPlugin.xpc (about 520 times a second while bluetoothd is off). Drop this
     file from the manifest to get Bluetooth audio back once bluetoothd runs. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.ioswitch.audio.bluetooth-off</string>
	<key>AudioServerPlugIn_LoadingConditions</key>
	<dict>
		<key>IOService Matching</key>
		<array>
			<dict>
				<key>IOProviderClass</key>
				<string>IOSwitchNoBluetoothAudio</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
