<dict>
	<key>Label</key>
	<string>com.ioswitch.joyconpaird</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/joyconpaird</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>POSIXSpawnType</key>
	<string>Adaptive</string>
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.iokit.matching</key>
		<dict>
			<key>com.ioswitch.joyconpaird.record</key>
			<dict>
				<key>IOProviderClass</key>
				<string>SwitchJoyConPairing</string>
				<key>IOMatchLaunchStream</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
