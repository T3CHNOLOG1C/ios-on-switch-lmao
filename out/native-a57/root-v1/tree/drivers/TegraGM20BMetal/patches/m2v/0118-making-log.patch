+/// The making log (ioswitch r8-webgpu): with `METAL2VULKAN_MAKING_LOG` naming a file, each record
+/// this process writes (a making the cache and its seed did not hold: a compile) appends one line
+/// to it, `<record name> <making's parts as text>`, a part named by a digest (`@<16 hex>`) printed
+/// once on a line of its own before it (`= <16 hex> <its parts>`). Two builds or two devices that
+/// make one pipeline under two names print where their descriptions part. Off by default; on, it
+/// only formats what a making already formats to name its record.
+pub(crate) struct MakingLog;
+
+static MAKING_LOG: std::sync::OnceLock<Option<std::sync::Mutex<MakingLogState>>> =
+    std::sync::OnceLock::new();
+
+struct MakingLogState {
+    file: std::fs::File,
+    /// The texts of the digests described lately, by their first 8 bytes' hex, and those printed.
+    described: std::collections::HashMap<String, String>,
+    printed: std::collections::HashSet<String>,
+}
+
+impl MakingLog {
+    fn state() -> Option<&'static std::sync::Mutex<MakingLogState>> {
+        MAKING_LOG
+            .get_or_init(|| {
+                let path = std::env::var_os("METAL2VULKAN_MAKING_LOG")?;
+                let file = std::fs::OpenOptions::new()
+                    .create(true)
+                    .append(true)
+                    .open(path)
+                    .ok()?;
+                Some(std::sync::Mutex::new(MakingLogState {
+                    file,
+                    described: std::collections::HashMap::new(),
+                    printed: std::collections::HashSet::new(),
+                }))
+            })
+            .as_ref()
+    }
+
+    fn on() -> bool {
+        Self::state().is_some()
+    }
+
+    fn described(digest: &Hash256, text: String) {
+        if let Some(state) = Self::state() {
+            let mut state = state.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+            if state.described.len() >= 256 {
+                state.described.clear();
+            }
+            state.described.insert(hex(&digest[..8]), text);
+        }
+    }
+
+    /// The line of the record `name`, written by a making described as `text`.
+    fn wrote(name: &str, text: &str) {
+        use std::io::Write;
+        let Some(state) = Self::state() else {
+            return;
+        };
+        let mut state = state.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+        let mut out = String::new();
+        for at in text.match_indices(" @").map(|(at, _)| at + 2) {
+            let Some(key) = text.get(at..at + 16) else {
+                continue;
+            };
+            if state.printed.contains(key) {
+                continue;
+            }
+            if let Some(parts) = state.described.get(key) {
+                out.push_str(&format!("= {key} {parts}\n"));
+                let key = key.to_owned();
+                state.printed.insert(key);
+            }
+        }
+        out.push_str(&format!("{name} {text}\n"));
+        let _ = state.file.write_all(out.as_bytes());
     }
 }
 
