[package]
name = "native-metal-bridge"
version = "0.1.0"
edition = "2024"
rust-version = "1.98"
# m2v sits below this workspace's root (tools/gpu/cargo_bridge.py links it in as m2v/) but is no member of it: its
# crates inherit from its own workspace manifest, and cargo hashes a path dependency inside the root by its relative
# path into the crates' symbol names (outside, by its absolute path, which would differ in every sandbox).
[workspace]
exclude = ["m2v"]
[lib]
crate-type = ["staticlib"]
path = "src/NativeMetalBridge.rs"
[dependencies]
metal2vulkan = { path = "m2v/crates/metal2vulkan", features = ["ash"] }
metal2vulkan-runtime = { path = "m2v/crates/metal2vulkan-runtime" }
libc = "0.2"
sha2 = { version = "0.10", features = ["asm"] }
# One codegen unit and fat LTO: the draw path crosses metal2vulkan and metal2vulkan-runtime at every step (r5-m2vfast:
# -11% encode CPU on the host simulation's CA frame; no shader cache key changes, the keys hash the sources).
[profile.release]
panic = "unwind"
debug = 1
codegen-units = 1
lto = "fat"
