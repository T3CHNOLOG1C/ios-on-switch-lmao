{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "ios-on-switch-lmao",
  "colors": {
    "primary": "#9A5B00",
    "light": "#F0A21E",
    "dark": "#9A5B00"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#121315"
    }
  },
  "fonts": {
    "heading": {
      "family": "Barlow Semi Condensed",
      "source": "/fonts/barlow-semi-condensed-600.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Barlow",
      "source": "/fonts/barlow-400.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["index", "installation"]
      },
      {
        "group": "The port",
        "pages": ["what-works", "how-it-works"]
      },
      {
        "group": "Development",
        "pages": ["contributing"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/brunostjohn/ios-on-switch-lmao"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/brunostjohn",
      "github": "https://github.com/brunostjohn/ios-on-switch-lmao"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  }
}
