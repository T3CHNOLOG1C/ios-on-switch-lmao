# translate/arm64e: arm64e (Apple A12, ARMv8.3) code on the Cortex-A57 (ARMv8.0), for iPadOS 26/27. README.md has the
# design. Not part of the iPadOS 17 boot: nothing under //:boot or //:gpu depends on this package.
#
#   bazel build //translate/arm64e:arm64e       the CLI: bazel run //translate/arm64e:arm64e -- COMMAND ARGS...
#   bazel test //translate/arm64e/...           semantic, layout and Mach-O tests on this Mac
#
#   :a64x     the translator: classify, one-word rewrites, stubs, liveness, page translation (freestanding C, also
#             compiled into XNU from xnu/)
#   :macho    host side: Mach-O images, the loader's translation of one image offline, chained fixups
#   :arm64e   the CLI over both (tools/)
#   :oracle   the classifier and translated words against LLVM (a developer check)
#   :xnu      the kernel side for xnu-12377.121.6 (sources and diff; not built, see xnu/README.md)
#   :prelink    the kext prelinker for fileset kernelcaches (xnu/prelink26; //kernel:kernel_12377 runs it)
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:inputs.bzl", "tool_output")

package(default_visibility = ["//visibility:public"])

# xnu/ holds XNU drop-ins (XNU's own style), a patch and records of the 12377 port.
lint_files(exclude = ["xnu/**"])

COPTS = [
    "-std=c11",
    "-Wall",
    "-Wextra",
    "-Werror",
]

exports_files(glob(["a64x/*"]) + [
    # kernel/tests' guard that the port record sets none of SpringBoard's never-dim keys
    "xnu/port-12377/switch-on-12377.diff",
])

filegroup(
    name = "a64x_srcs",
    srcs = [
        "a64x/a64x.h",
        "a64x/a64x_classify.c",
        "a64x/a64x_fp16.h",
        "a64x/a64x_image.c",
        "a64x/a64x_refs.c",
        "a64x/a64x_rewrite.c",
        "a64x/a64x_vlive.h",
    ],
)

MACHO_SRCS = [
    "macho/codesign.c",
    "macho/dsc.c",
    "macho/dsc_verify.c",
    "macho/fips.c",
    "macho/macho.c",
    "macho/pretranslate.c",
    "macho/pt_entries.c",
    "macho/pt_verify.c",
    "macho/sha256.c",
    "macho/stub_split.c",
]

MACHO_HDRS = [
    "macho/codesign.h",
    "macho/dsc.h",
    "macho/fips.h",
    "macho/macho.h",
    "macho/pretranslate.h",
    "macho/sha256.h",
    "macho/stub_split.h",
]

filegroup(
    name = "macho_srcs",
    srcs = MACHO_SRCS + MACHO_HDRS,
)

cc_library(
    name = "a64x",
    srcs = [
        "a64x/a64x_classify.c",
        "a64x/a64x_image.c",
        "a64x/a64x_refs.c",
        "a64x/a64x_rewrite.c",
    ],
    hdrs = ["a64x/a64x.h"],
    copts = COPTS,
    textual_hdrs = [
        "a64x/a64x_fp16.h",
        "a64x/a64x_vlive.h",
    ],
)

cc_library(
    name = "macho",
    srcs = MACHO_SRCS,
    hdrs = MACHO_HDRS,
    copts = COPTS,
    deps = [":a64x"],
)

cc_binary(
    name = "arm64e",
    srcs = glob([
        "tools/*.c",
        "tools/*.h",
    ]),
    copts = COPTS,
    deps = [":macho"],
)

# What the image build's prelink and pretranslation run: this build's, or the release's prebuilt one on a Mac
# without Xcode (--//install:prebuilt=release).
alias(
    name = "arm64e_tool",
    actual = select({
        "//install:from_release": "@switch_release//:arm64e",
        "//conditions:default": ":arm64e",
    }),
)

# The same tool as a universal binary for the Intel Macs' host-tools asset (release/BUILD.bazel), down to macOS 12.
tool_output(
    name = "arm64e_universal",
    srcs = glob([
        "a64x/*.c",
        "a64x/*.h",
        "macho/*.c",
        "macho/*.h",
        "tools/*.c",
        "tools/*.h",
    ]),
    outs = ["universal/arm64e"],
    args = [
        "--xcode-env={xcode_env}",
        "--out={out}",
        "--flag=-arch",
        "--flag=x86_64",
        "--flag=-mmacosx-version-min=12.0",
    ] + ["--flag=" + flag for flag in COPTS] + [
        "$(execpath {})".format(f)
        for f in ["a64x/a64x_classify.c", "a64x/a64x_image.c", "a64x/a64x_refs.c", "a64x/a64x_rewrite.c"] +
                 MACHO_SRCS + glob(["tools/*.c"])
    ],
    message = "Building the arm64e translator (universal)",
    tool = "host_c_binary.py",
)

# blacktop/ipsw for the Mac running the iOS 27 prelink: the release's arm64 or x86_64 build, by this Mac's CPU.
alias(
    name = "ipsw_cli",
    actual = select({
        "@platforms//cpu:x86_64": "@ipsw_cli_x86_64//:ipsw",
        "//conditions:default": "@ipsw_cli//:ipsw",
    }),
)

# The pure-Python string discriminators against clang's builtin, compiled for arm64e and run here.
py_test(
    name = "ptrauth_disc_test",
    size = "small",
    srcs = ["xnu/prelink26/ptrauth_disc_test.py"],
    deps = [":prelink26"],
    tags = ["requires-darwin"],
)

# The classifier and translated words against LLVM's disassembler (needs llvm-mc: LLVM_MC=...).
py_binary(
    name = "oracle",
    srcs = ["tools/oracle.py"],
    data = [":arm64e"],
)

filegroup(
    name = "xnu",
    srcs = glob(["xnu/**"]),
)

# The kext prelinker for fileset kernelcaches (iPadOS 26/27): prelink.py runs its steps over a work directory
# (paths.py). bindings*.py and check_got_order_17.py are the 26.5.2 bindings run as it was, with that run's paths.
py_library(
    name = "prelink26",
    srcs = glob(
        ["xnu/prelink26/*.py"],
        exclude = ["xnu/prelink26/*_test.py"],
    ),
    deps = [
        "//tools/common:macho",
        "//tools/prelink:native_prelink",
    ],
)

py_binary(
    name = "prelink",
    srcs = ["xnu/prelink26/prelink.py"],
    main = "xnu/prelink26/prelink.py",
    deps = [":prelink26"],
)

# shapes.py with the instructions of the bindings it refuses (24B119's kalloc.c frees, port_name_to_task).
py_test(
    name = "shapes_test",
    size = "small",
    srcs = ["xnu/prelink26/shapes_test.py"],
    imports = ["xnu/prelink26"],
    deps = [":prelink26"],
)

# The selected kind's iOS 27 kernel names: no binding whose instructions are not our function's.
py_test(
    name = "prelink_shapes_test",
    size = "small",
    srcs = ["xnu/prelink26/prelink_shapes_test.py"],
    data = ["//kernel:prelink_report"],
    deps = ["@rules_python//python/runfiles"],
)
