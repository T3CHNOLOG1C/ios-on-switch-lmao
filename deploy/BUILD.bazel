# Updating an installed card from the Mac (no sudo). See tools/deploy/deploy.py and pull_logs.py.
#
#   bazel run //deploy:sd -- disk4                          dry run
#   bazel run //deploy:sd -- disk4 --yes                    deploy //:boot (pull logs first, eject after)
#   bazel run //deploy:sd --//deploy:gpu_bundle=//gpu:bundle -- disk4 --yes --stage-gpu
#   bazel run //deploy:pull_logs -- disk4                   logs + logarchive + m2v harvest only
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

# The boot package deploy and install write (a directory: switchroot/ioswitch/, bootloader/ini/, overlay/).
label_flag(
    name = "boot_package",
    build_setting_default = "//:boot",
)

# The Metal bundle --stage-gpu stages (a directory: ngpu/addons/..., TegraGM20BMetal.trustcache).
label_flag(
    name = "gpu_bundle",
    build_setting_default = "//gpu:bundle",
)

py_binary(
    name = "sd",
    srcs = ["//tools/deploy:deploy.py"],
    args = [
        "--boot-package=$(rlocationpath :boot_package)",
        "--spec=$(rlocationpath //install:spec)",
        "--gpu-bundle=$(rlocationpath :gpu_bundle)",
        "--stager=$(rlocationpath //out/native-a57/root-v1/tree/drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py)",
        "--kcdata=$(rlocationpath @xnu_base//:tools/lldbmacros/kcdata.py)",
    ],
    data = [
        ":boot_package",
        ":gpu_bundle",
        "//install:spec",
        "//out/native-a57/root-v1/tree/drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py",
        "@xnu_base//:tools/lldbmacros/kcdata.py",
    ],
    main = "//tools/deploy:deploy.py",
    deps = [
        "//tools/deploy:lib",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "pull_logs",
    srcs = ["//tools/deploy:pull_logs.py"],
    args = [
        "--spec=$(rlocationpath //install:spec)",
        "--kcdata=$(rlocationpath @xnu_base//:tools/lldbmacros/kcdata.py)",
    ],
    data = [
        "//install:spec",
        "@xnu_base//:tools/lldbmacros/kcdata.py",
    ],
    main = "//tools/deploy:pull_logs.py",
    deps = [
        "//tools/deploy:lib",
        "@rules_python//python/runfiles",
    ],
)
