# Python and macOS
__pycache__/
*.pyc
.DS_Store

# Inputs too large or not ours to track: third-party clones, firmware bundles, disk images, photos
vendor/
bundles/
*.ipsw
*.apfs
*.raw
*.dmg
*.HEIC
*.heic
# ...except the video decoder's test inputs
!/drivers/SwitchVideoDecoders/test/*.heic

# Editor/agent leftovers
*.orig
*.rej

# out/: agents' scratch only (build output is bazel-out, boot snapshots and device logs live in
# ~/Library/Application Support/ioswitch). Nothing in it is tracked.
/out/

# Claude Code worktrees and local state
.claude/

# Bazel: convenience symlinks, personal flags, execution logs
/bazel-*
/user.bazelrc
/repro-exec.log.zst

# clangd: its database (`bazel run //tools/lint:compdb`) and its background index.
/compile_commands.json
/.cache/
