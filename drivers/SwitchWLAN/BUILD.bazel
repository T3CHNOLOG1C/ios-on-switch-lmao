# drivers/SwitchWLAN: moved from out/native-a57/root-v1/tree/drivers/SwitchWLAN by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# SwitchWLAN: BCM4356A3 Wi-Fi on PCIe port 1; firmware.S .incbins drivers/SwitchWLAN/firmware.
kernel_driver(
    name = "SwitchWLAN",
    srcs = [
        "SwitchWLAN.cpp",
        "SwitchWLANProbe.cpp",
        "TegraPCIe.cpp",
        "SwitchWLANChip.cpp",
        "SwitchWLANMsgbuf.cpp",
        "SwitchWLANCrypto.cpp",
        "SwitchWLANWpa.cpp",
        "SwitchWLANNet.cpp",
        "SwitchWLANAwdl.cpp",
        "awdl/awdl_wire.c",
        "awdl/awdl_core.c",
        "awdl/awdl_bcm.c",
        "awdl/awdl_bcm_trace.c",
        "awdl/awdl_apple80211.c",
        "firmware.S",
    ],
    c_copts = [
        "-mgeneral-regs-only",
        "-mstrict-align",
        "-std=gnu11",
    ],
    copts = [
        "-mgeneral-regs-only",
        "-mstrict-align",
    ],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/SwitchBluetooth",
        "drivers/SwitchSuspend",
        "drivers/TegraI2C",
    ],
)

