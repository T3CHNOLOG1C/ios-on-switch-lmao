# drivers/SwitchWLAN: moved from out/native-a57/root-v1/tree/drivers/SwitchWLAN by the layout move.
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/kernel:kernel.bzl", "kernel_driver", "kernel_headers")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# SwitchWLAN: BCM4356A3 Wi-Fi on PCIe port 1 (switch-wlan=1); firmware.S .incbins drivers/SwitchWLAN/firmware.
kernel_driver(
    name = "SwitchWLAN",
    srcs = [
        "SwitchWLAN.cpp",
        "SwitchWLANProbe.cpp",
        "TegraPCIe.cpp",
        "SwitchWLANChip.cpp",
        "SwitchWLANMsgbuf.cpp",
        "SwitchWLANCrypto.cpp",
        "SwitchWLANWpa.cpp",
        "SwitchWLANNet.cpp",
        "SwitchWLANAwdl.cpp",
        "awdl/awdl_wire.c",
        "awdl/awdl_core.c",
        "awdl/awdl_bcm.c",
        "awdl/awdl_bcm_trace.c",
        "awdl/awdl_apple80211.c",
        "firmware.S",
    ],
    c_copts = [
        "-mgeneral-regs-only",
        "-mstrict-align",
        "-std=gnu11",
    ],
    copts = [
        "-mgeneral-regs-only",
        "-mstrict-align",
    ],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/SwitchBluetooth",
        "drivers/TegraI2C",
    ],
)

# SwitchWLAN's AWDL core and awdl0's Apple80211 side (drivers/SwitchWLAN/awdl): frame codec, sync, election, data path,
# the IO80211 event ring, over a simulated air of nodes with skewed clocks; the firmware's AWDL: every iovar payload
# byte for byte against the brcmfmac AWDL series' traced bytes and the 2014 wlioctl layouts, the probe, both
# firmware generations' bring-up against a mock firmware (ASan + UBSan).
py_test(
    name = "awdl_test",
    size = "small",
    srcs = ["awdl/tests/test_awdl.py"],
    data = glob(["awdl/**"]),
    main = "awdl/tests/test_awdl.py",
    tags = ["requires-darwin"],
)
