<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Wi-Fi bring-up: keeps configd's info and debug messages (plugin load/start/prime, KernelEventMonitor's
     "Process interface attach", InterfaceNamer's "IOKit quiet") in the persisted log. Goes to the Data volume at
     /private/var/preferences/Logging/Subsystems/ (that is /Library/Preferences/Logging/Subsystems/); remove it once
     Wi-Fi joins. -->
<plist version="1.0">
<dict>
	<key>DEFAULT-OPTIONS</key>
	<dict>
		<key>Default-Privacy-Setting</key>
		<string>Public</string>
		<key>Level</key>
		<dict>
			<key>Enable</key>
			<string>Debug</string>
			<key>Persist</key>
			<string>Debug</string>
		</dict>
	</dict>
</dict>
</plist>
