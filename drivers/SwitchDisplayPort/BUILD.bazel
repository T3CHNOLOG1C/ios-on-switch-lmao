# SwitchDisplayPort: TV output over the USB-C port, as the dock does it (DisplayPort alternate mode into the dock's
# DisplayPort-to-HDMI converter). Built and host-tested, linked only with --//drivers/SwitchDisplayPort:enabled.
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:kernel.bzl", "kernel_driver")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

bool_flag(
    name = "enabled",
    build_setting_default = False,
)

config_setting(
    name = "on",
    flag_values = {":enabled": "True"},
)

# The BM92T36 alternate-mode engine runs when any feature behind the dock needs it.
selects.config_setting_group(
    name = "alt_mode",
    match_any = [
        ":on",
        "//drivers/SwitchUSB:superspeed_on",
    ],
)

# kernel_headers() by hand: the same headers, plus SWITCH_DISPLAYPORT=1 for every driver that names this directory in
# its hdr_deps (SwitchUSB's SwitchPD.cpp), only with the setting on.
filegroup(
    name = "headers",
    srcs = glob(["*.h"]),
)

cc_library(
    name = "hdrs",
    hdrs = [":headers"],
    defines = select({
        ":on": ["SWITCH_DISPLAYPORT=1"],
        "//conditions:default": [],
    }),
    tags = ["kernel"],
    target_compatible_with = ["//bazel/platforms:kernel"],
)

# The BM92T36 alternate-mode engine: SwitchPD (drivers/SwitchUSB) calls it under SWITCH_DISPLAYPORT or
# SWITCH_USB_SUPERSPEED; kernel/BUILD.bazel links it with :alt_mode.
kernel_driver(
    name = "SwitchPDAltMode",
    srcs = ["SwitchPDAltMode.cpp"],
    hdr_deps = [
        "drivers/SwitchUSB",
        "drivers/TegraI2C",
    ],
)

# DPAUX1, SOR1, display controller B and the external screen; kernel/BUILD.bazel links it with :on.
kernel_driver(
    name = "SwitchDisplayPort",
    srcs = [
        "SwitchDisplayPort.cpp",
        "SwitchDPSession.cpp",
        "SwitchExternalScreen.cpp",
        "TegraDisplayB.cpp",
        "TegraDpaux1.cpp",
        "TegraSor1.cpp",
    ],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/TegraI2C",
        "kits/SwitchCAR",
        "kits/SwitchMMIO",
    ],
)
