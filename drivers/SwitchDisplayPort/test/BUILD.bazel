# drivers/SwitchDisplayPort's pure-C policies on the host:
#   alt_mode_test   the BM92T36 alternate-mode steps against a model dock, adapters and chargers; pin assignment D first
#   dp_modes_test   EDID parsing and the 1080p60 cap on the mode driven
#   dp_link_test    the link for a mode, SOR1's transfer units (Linux's numbers), PLL_D2, training against a model sink
#   dp_aux_test     DPAUX1 control words (Linux's), replies, retries, the EDID read plan
#   policy_c11      every header again as C11 under -Wconversion -Wsign-conversion
#
#   bazel test //drivers/SwitchDisplayPort/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

POLICY = [
    "//drivers/SwitchDisplayPort:SwitchDPAux.h",
    "//drivers/SwitchDisplayPort:SwitchDPLink.h",
    "//drivers/SwitchDisplayPort:SwitchDPModes.h",
    "//drivers/SwitchDisplayPort:SwitchDPTraining.h",
    "//drivers/SwitchDisplayPort:SwitchPDAltMode.h",
    "//drivers/SwitchDisplayPort:SwitchPDAltModeSteps.h",
]

host_library(
    name = "policy_c11",
    srcs = ["policy_c11.c"] + POLICY,
    copts = [
        "-Wconversion",
        "-Wsign-conversion",
    ],
)

host_test(
    name = "alt_mode_test",
    srcs = ["alt_mode_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)

host_test(
    name = "dp_modes_test",
    srcs = ["dp_modes_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)

host_test(
    name = "dp_link_test",
    srcs = ["dp_link_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)

host_test(
    name = "dp_aux_test",
    srcs = ["dp_aux_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)
