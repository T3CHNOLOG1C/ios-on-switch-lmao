load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraAPBDMA: moved from out/native-a57/root-v1/tree/drivers/TegraAPBDMA by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# APB DMA for the UARTs (Joy-Con rails' RX, Bluetooth's TX and RX).
kernel_driver(
    name = "TegraAPBDMA",
    hdr_deps = [
        "drivers/ArmGIC",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchMMIO",
    ],
)
