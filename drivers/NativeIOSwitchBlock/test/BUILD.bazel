# drivers/NativeIOSwitchBlock on the host: the SD driver's header-only engines against models (ADMA2 descriptor tables
# and their staging, the SD card's register decoders and command encodings, the client copy through copypv, the
# command-queue engine against a model card, read-chain merging, the cryptex direct read map and prefetch runs), and
# guards on what NativeIOSwitchBlock.cpp and IOSwitchCryptex.cpp do with them (*_source_test: the drivers themselves
# are not built for the host).
#
#   bazel test //drivers/NativeIOSwitchBlock/test:all
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_test")

lint_files()

# The randomized tests run their thousands of cases at -O1 (as the cryptex map's always did): ASan at -O0 took
# minutes.
host_test(
    name = "sd_adma_test",
    srcs = [
        "sd_adma_test.cpp",
        "//drivers/NativeIOSwitchBlock:IOSwitchAdma.h",
    ],
    copts = ["-O1"],
)

host_test(
    name = "sd_card_test",
    srcs = [
        "sd_card_test.cpp",
        "//drivers/NativeIOSwitchBlock:IOSwitchSdCard.h",
    ],
)

# copypv's flag values, from the XNU the driver links against (its osfmk/vm/pmap.h): the seven the helper and the test
# use, each required.
genrule(
    name = "xnu_pmap_flags",
    testonly = True,
    srcs = ["//kernel/xnu-10063.141.1:osfmk/vm/pmap.h"],
    outs = ["xnu_pmap_flags.h"],
    cmd = """
set -e
echo "// copypv flags, from XNU osfmk/vm/pmap.h (generated by //drivers/NativeIOSwitchBlock/test:xnu_pmap_flags)." > $@
for flag in cppvPsnk cppvPsrc cppvFsnk cppvFsrc cppvNoModSnk cppvNoRefSrc cppvKmap; do
    line=$$(sed -nE "s/.*#define[[:space:]]+($$flag)[[:space:]]+([0-9]+).*/#define \\1 \\2/p" $< | head -n 1)
    if [ -z "$$line" ]; then echo "no #define $$flag in $<" >&2; exit 1; fi
    echo "$$line" >> $@
done
""",
)

cc_library(
    name = "xnu_pmap_flags_header",
    testonly = True,
    hdrs = [":xnu_pmap_flags"],
    includes = ["."],
)

host_test(
    name = "sd_client_copy_test",
    srcs = [
        "sd_client_copy_test.cpp",
        "//drivers/NativeIOSwitchBlock:IOSwitchClientCopy.h",
    ],
    deps = [":xnu_pmap_flags_header"],
)

