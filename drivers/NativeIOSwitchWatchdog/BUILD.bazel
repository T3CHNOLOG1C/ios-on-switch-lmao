# drivers/NativeIOSwitchWatchdog: moved from out/native-a57/root-v1/tree/drivers/NativeIOSwitchWatchdog by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# Watchdog: an IOWatchdog (subclass of the original in AppleARMWatchdogTimer, late) so launchd starts watchdogd, which
# stackshots and kills a hung SpringBoard or backboardd. Published from the board thread.
kernel_driver(
    name = "NativeIOSwitchWatchdog",
    srcs = [
        "NativeIOSwitchWatchdogPublish.cpp",
        "NativeIOSwitchWatchdog.cpp",
        "original-bindings.S",
    ],
    hdr_deps = [
        "drivers/SwitchPower",
    ],
    late = ["NativeIOSwitchWatchdog.cpp"],
    # No prelink entry: AppleARMWatchdogTimer is already prelinked as apfs's dependency (naming it as a root reorders
    # the inherited original extents, which emit_prelink.py refuses).
    stems = {"original-bindings.S": "watchdog-original-bindings"},
)
