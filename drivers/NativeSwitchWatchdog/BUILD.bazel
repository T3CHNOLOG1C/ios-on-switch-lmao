load("//bazel/lint:defs.bzl", "lint_files")

# drivers/NativeSwitchWatchdog: moved from out/native-a57/root-v1/tree/drivers/NativeSwitchWatchdog by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kits/SwitchABI:defs.bzl", "switch_abi_bindings")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# Watchdog: an IOWatchdog (subclass of the original in AppleARMWatchdogTimer, late) so launchd starts watchdogd, which
# stackshots and kills a hung SpringBoard or backboardd. Published from the board thread.
kernel_driver(
    name = "NativeSwitchWatchdog",
    srcs = [
        "NativeSwitchWatchdogPublish.cpp",
        "NativeSwitchWatchdog.cpp",
        "original-bindings.S",
    ],
    abi = ["IOWatchdog"],
    hdr_deps = [
        "drivers/SwitchPower",
    ],
    late = ["NativeSwitchWatchdog.cpp"],
    # No prelink entry: AppleARMWatchdogTimer is already prelinked as apfs's dependency (naming it as a root reorders
    # the inherited original extents, which emit_prelink.py refuses).
    stems = {"original-bindings.S": "watchdog-original-bindings"},
)

switch_abi_bindings(
    name = "original_bindings",
    out = "original-bindings.S",
    classes = ["//kits/SwitchABI:IOWatchdog"],
    objects = [":NativeSwitchWatchdog_cc"],
)
