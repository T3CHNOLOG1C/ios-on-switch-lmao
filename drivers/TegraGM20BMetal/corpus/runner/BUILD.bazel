# m2v-corpus: every function of one metallib through the metal2vulkan runtime (the bridge's device options) on the host NVK
# over the mock GM20B user client (src/main.rs). corpus/tools/run_corpus.py runs it (RUNNER):
#
#   bazel build //drivers/TegraGM20BMetal/corpus/runner:m2v-corpus
#   RUNNER=bazel-bin/drivers/TegraGM20BMetal/corpus/runner/m2v-corpus run_corpus.py ...
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/rust:defs.bzl", "rust_artifact_binary")

lint_files()

rust_binary(
    name = "m2v-corpus_crate",
    srcs = ["src/main.rs"],
    crate_name = "m2v_corpus",
    edition = "2024",
    version = "0.1.0",
    deps = [
        "//third_party/m2v/crates/metal2vulkan",
        "//third_party/m2v/crates/metal2vulkan-air",
        "//third_party/m2v/crates/metal2vulkan-runtime",
    ],
)

# Built as a tool of this Mac (optimized, no LTO), in either profile.
rust_artifact_binary(
    name = "m2v-corpus",
    crate = ":m2v-corpus_crate",
    kind = "tool",
)
