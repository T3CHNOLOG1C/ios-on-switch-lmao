# drivers/IOSwitchAccelStub: moved from out/native-a57/root-v1/tree/drivers/IOSwitchAccelStub by the layout move.
load("//bazel/kernel:kernel.bzl", "kernel_driver", "kernel_headers")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# Accelerator stub: ends QuartzCore's 30 s IOAcceleratorES poll.
kernel_driver(
    name = "IOSwitchAccelStub",
    srcs = [
        "IOSwitchAccelStubPublish.cpp",
        "IOSwitchAccelStub.cpp",
        "original-bindings.S",
    ],
    hdr_deps = [],
    late = ["IOSwitchAccelStub.cpp"],
    prelink = ["com.apple.iokit.IOGPUFamily"],
)
