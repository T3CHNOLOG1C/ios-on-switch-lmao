<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Shown over /System/Library/Audio/Plug-Ins/HAL/BTAudioHALPlugin.driver/Info.plist by the Data overlay (overlay/manifest.json).
     The audio server (CoreAudio HALS_PlugInManager::LoadPlugIns) defers a plug-in whose loading condition matches no
     IOService, before it loads any code: no service publishes this class, so the Bluetooth plug-in never starts and never
     retries bluetoothd's com.apple.BTAudioHALPlugin.xpc (about 520 times a second while bluetoothd is off). Only for a
     console without Bluetooth: the manifest entry's "unless-boot-arg": "switch-bt" leaves it out of a package whose
     command line has switch-bt=1, where the plug-in must load and connect to bluetoothd (A2DP, HFP; r7l had none). -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.brunostjohn.switch.audio.bluetooth-off</string>
	<key>AudioServerPlugIn_LoadingConditions</key>
	<dict>
		<key>IOService Matching</key>
		<array>
			<dict>
				<key>IOProviderClass</key>
				<string>SwitchNoBluetoothAudio</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
