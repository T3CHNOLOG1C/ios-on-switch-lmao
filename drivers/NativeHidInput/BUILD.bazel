load("//bazel/lint:defs.bzl", "lint_files")

# drivers/NativeHidInput: moved from out/native-a57/root-v1/tree/drivers/NativeHidInput by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kits/SwitchABI:defs.bzl", "switch_abi_bindings")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "NativeHidInput",
    srcs = [
        "NativeHidInput.cpp",
        "original-bindings.S",
    ],
    abi = ["IOHIDDevice"],
    hdr_deps = [],
    late = ["NativeHidInput.cpp"],
    stems = {"original-bindings.S": "hid-original-bindings"},
)

switch_abi_bindings(
    name = "original_bindings",
    out = "original-bindings.S",
    classes = ["//kits/SwitchABI:IOHIDDevice"],
    objects = [":NativeHidInput_cc"],
)
