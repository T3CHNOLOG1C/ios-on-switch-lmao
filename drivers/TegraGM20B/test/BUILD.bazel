# drivers/TegraGM20B on the host:
#   gm20b_coherency_test     TegraGM20BCoherency.cpp: which IOSurface lock/unlock traps clean or invalidate an import,
#                            across imports of one surface and their release, and traps racing a release
#   gm20b_wiring_test        TegraGM20BSharedWiring.cpp: one wiring per task and range, shared while the task still
#                            maps it there, a racing publish, the last import's release
#   gm20b_tlb_test           TegraGM20BTlb.h over a GMMU model (PTEs, the L2's copies, a TLB per space, running work
#                            that refills it): GPU-ordered maps and synchronous unmaps never reach a released page
#   gm20b_pool_policy_test   TegraGM20BPoolPolicy.h (where a coherent BO's memory comes from) over a model of the pool
#                            when Maps opened: its first buffers come from system memory instead of being refused;
#                            MapKit's 4 KiB, the compositor's 16 MiB block, the floor, room for everyone
#   gm20b_push_scan_test     TegraGM20BPushScan.h (the kernel's method-stream reader and the push profile's classes) over
#                            streams laid out as NVK writes them: every counter, and no profile stamp after a push whose
#                            method continues, one the kernel could not read or one with an opcode NVK never writes
#   gm20b_sleep_test         TegraGM20BSleepGate.h (system sleep's gate and plan): every transition, and on threads with
#                            gpu.c's sleeping protocol around it, no caller inside between the drain and the wake, a
#                            submission waiting at the gate goes on at the wake, a caller that never leaves fails the drain
#   gm20b_source_test        how the user client and gpu.c use both, the pool's zeroing (nvkm shim, scrubber), the
#                            fence-only present, and which paths go through the sleep gate in what order (none of which a
#                            host model runs); NVK's stencil copy temp on the bind alignment
#
#   bazel test //drivers/TegraGM20B/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_shims", "host_test")

lint_files()

host_test(
    name = "gm20b_pool_policy_test",
    srcs = [
        "gm20b_pool_policy_test.cpp",
        "//drivers/TegraGM20B:TegraGM20BPoolPolicy.h",
    ],
    cxx_std = "c++17",
)

host_test(
    name = "gm20b_push_scan_test",
    srcs = [
        "gm20b_push_scan_test.cpp",
        "//drivers/TegraGM20B:TegraGM20BGpu.h",
        "//drivers/TegraGM20B:TegraGM20BPushScan.h",
    ],
    copts = ["-Wno-unused-parameter"],
    cxx_std = "c++17",
)

host_test(
    name = "gm20b_sleep_test",
    srcs = [
        "gm20b_sleep_test.cpp",
        "//drivers/TegraGM20B:TegraGM20BSleepGate.h",
    ],
    cxx_std = "c++17",
)

host_test(
    name = "gm20b_source_test",
    srcs = ["gm20b_source_test.cpp"],
    # c++20 (not the harnesses' c++17): bazel/testing's headers use string_view and nested namespaces.
    data = [
        "//drivers/TegraGM20BMetal:raw/runtime/raw_kernel.cpp",
        "//third_party/mesa/src/nouveau/vulkan:nvkmd/darwin/nvkmd_darwin.c",
        "//third_party/mesa/src/nouveau/vulkan:nvk_image.c",
        "//drivers/TegraGM20B:TegraGM20BUserClient.cpp",
