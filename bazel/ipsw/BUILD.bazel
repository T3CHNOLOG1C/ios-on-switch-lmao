load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")
load(":ipsw.bzl", "ipsw_members")

lint_files()

# `bazel run //bazel/ipsw:pin -- <ipsw url> <product> <device class> > $PWD/bazel/ipsw/pins.bzl`
py_binary(
    name = "pin",
    srcs = ["pin.py"],
)

# Inflates a deflated member's bytes and checks the content against its pin (ipsw_inflate runs it).
py_binary(
    name = "inflate",
    srcs = ["inflate.py"],
)

# The deflated members, inflated: //bazel/ipsw:<role> (what @ipsw//:<role> names).
ipsw_members()
