# Inputs the build cannot regenerate, checked in with their sha256 (SHA256SUMS: `shasum -a 256` lines). @pinned
# (bazel/host/files.bzl pinned_files) copies each in through Bazel's own sha256 check and fails on a mismatch or on a
# file SHA256SUMS does not list; `bazel test //bazel/pinned:sha256` builds it.
#
#   kernel/*/original-bindings.S, kernel/*/*ABI.h, GuardedPMGRSlots.inc
#       Absolute-address tables into the 21H461 kernelcache and ABI headers, written by the kernel tree's audit scripts
#       (build-ioswitch-root-block.py, build-native-legacy-display.py, build-native-hid-input.py,
#       build-platform-power.py, all retired) from QEMU-boot interface audits that cannot run in a sandbox.
#       kernel/native-aes/original-bindings.S: NativeAES's, from the same audits.
#   kernel/verified-root-ioswitch/trusted-key.S
#       The owner verification key (openssl, never regenerated).
#   data-seed/data-v10.dbr
#       NativeRamBlock's packed 1 GiB Data seed (DBRDISK1). Contains Apple-derived /private/var content from the
#       21H461 OS volume: check the licence before publishing the repository.
#   prelink/dma-kernel.json.xz, prelink/dma-prelink.json
#       The V20 prelink report the SMP prelink inherits (its parent pass no longer exists) and its roots.
#   firmware/bl31.bin, bl33.bin, oled-sku3.dtb
#       switchroot's ATF and U-Boot (Ubuntu Noble 5.1.2 entry; U-Boot 2024.NX02 @ 722e2b86) and the OLED device tree
#       (nx-plat.dtimg entry 3), as the boot entry chains them.
#   firmware/exporter.uimg
#       The RAM metadata exporter (bazel run //native:firmware_export rebuilds it).
#   firmware/BCM4356A3.hcd
#       The Bluetooth controller's patch RAM (gitlab.com/switchroot/android/nx-firmware).
#   overlay/apple-logo~ipad.png
#       ProgressUI's 1x boot logo (bazel run //tools/package:progressui_logo remakes it; Apple's artwork).

load("@bazel_skylib//rules:build_test.bzl", "build_test")

package(default_visibility = ["//visibility:public"])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

build_test(
    name = "sha256",
    targets = ["@pinned//:all"],
)
