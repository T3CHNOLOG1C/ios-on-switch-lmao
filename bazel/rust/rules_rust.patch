+def own_codegen_value(rustc_flags, option):
+    """The value of the `-C<option>=` a crate's `rustc_flags` carry, or None (ios-on-switch-lmao).
+
+    A crate that names its own `metadata` and `extra-filename` (the values cargo or meson gives it, so that its symbols and
+    its rlib's member names are theirs) gets neither from rules_rust as well: rustc hashes every `-C metadata` value into
+    the crate's identity. Its `extra-filename` (else its `metadata`) stands in for the output hash in the rlib's name.
+
+    Args:
+        rustc_flags (list): The crate's `rustc_flags` attribute.
+        option (str): `metadata` or `extra-filename`.
+
+    Returns:
+        str: The value, or None.
+    """
+    for flag in rustc_flags:
+        for prefix in ("-C" + option + "=", "--codegen=" + option + "="):
+            if type(flag) == "string" and flag.startswith(prefix):
+                return flag[len(prefix):]
+    return None
+
+def own_output_hash(rustc_flags):
+    """The output hash a crate's own `-Cextra-filename=-<hash>` or `-Cmetadata=<hash>` names, or None (ios-on-switch-lmao).
+
+    Args:
+        rustc_flags (list): The crate's `rustc_flags` attribute.
+
+    Returns:
+        str: The hash, or None.
+    """
+    extra = own_codegen_value(rustc_flags, "extra-filename")
+    if extra:
+        return extra.removeprefix("-")
+    return own_codegen_value(rustc_flags, "metadata")
+
