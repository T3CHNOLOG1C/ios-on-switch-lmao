+_INCREMENTAL = "-Cincremental="
+
+def incremental_base(flags):
+    """The base directory of an `-Cincremental=<base>` among a crate's extra rustc flags, or None (ios-on-switch-lmao).
+
+    rustc's incremental compilation for a crate a per-crate rustc flag opts in (bazel/rust/defs.bzl: the debug profile's
+    first-party crates). rustc keeps one session directory per crate below the base; this makes the base one per
+    configuration, so two configurations never share a session. A crate's two pipelined actions do share one: their
+    rustc command lines are the same, the full action finalizes its session, and the metadata action (stopped once the
+    .rmeta is written, so it never finalizes its own) starts from the last finalized one.
+
+    Args:
+        flags (list): The crate's extra rustc flags.
+
+    Returns:
+        str: The base, or None.
+    """
+    for flag in flags:
+        if type(flag) == "string" and flag.startswith(_INCREMENTAL):
+            return flag[len(_INCREMENTAL):]
+    return None
+
+def incremental_dir(ctx, base):
+    """The session base of a crate's actions: <base>/<configuration's bin directory> (ios-on-switch-lmao)."""
+    return "{}/{}".format(base, ctx.bin_dir.path)
+
+def _incremental_requirements(ctx, toolchain, crate_info, requirements):
+    """`requirements` plus no-sandbox when the crate compiles incrementally (ios-on-switch-lmao): rustc writes its session below
+    the output base, outside the sandbox. The rlib is still a declared output (cached, path-independent); only the
+    session directory is outside Bazel."""
+    if not incremental_base(collect_extra_rustc_flags(ctx, toolchain, crate_info.root, crate_info.type)):
+        return requirements
+    return dict(requirements or {}) | {"no-sandbox": "1"}
+
