load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//bazel/lint:defs.bzl", "lint_files")
load(":profile_test.bzl", "profile_tests")

package(default_visibility = ["//visibility:public"])

lint_files()

# The build profile, one setting for the whole graph (--config=debug / --config=release in .bazelrc set it):
#   debug    (default) the fastest incremental builds: no LTO, asserts on, symbols, XNU DEVELOPMENT
#   release  full optimisation: fat LTO everywhere, NDEBUG, XNU RELEASE, stripped
# Every stream maps it onto its own flags with select() on :debug / :release (never by reading .bazelrc).
string_flag(
    name = "profile",
    build_setting_default = "debug",
    # Target configuration only: exec tools (compilers, generators, test runners) never differ by profile, so switching
    # profiles reuses every exec action.
    scope = "target",
    values = [
        "debug",
        "release",
    ],
)

config_setting(
    name = "debug",
    flag_values = {":profile": "debug"},
)

config_setting(
    name = "release",
    flag_values = {":profile": "release"},
)

profile_tests(
    name = "profile_test",
    objcxx_source = "//drivers/TegraGM20BMetal:TegraGM20BMetalPlugin.mm",
    source = "//drivers/SwitchBluetooth:BlueTool/BlueTool.c",
)

# The console the image is for. aula (default) is the OLED, T210B01; icosa the original 2017 Switch, T210 (Erista).
# It picks the board ADT's identity, U-Boot's board check and the emulator's fuses (--config=erista in .bazelrc).
string_flag(
    name = "board",
    build_setting_default = "aula",
    scope = "target",
    values = [
        "aula",
        "icosa",
    ],
)

config_setting(
    name = "board_aula",
    flag_values = {":board": "aula"},
)

config_setting(
    name = "board_icosa",
    flag_values = {":board": "icosa"},
)
