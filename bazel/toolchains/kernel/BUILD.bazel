# The kernel's C/C++/assembly toolchain (config.bzl): Apple clang with XNU's compile recipes as features, for
# //bazel/platforms:ios_kernel_arm64. Registered in MODULE.bazel; the kernel's cc targets reach it through
# kernel_driver's transition (bazel/kernel/kernel.bzl).
#
#   bazel run //bazel/toolchains/kernel:update_recipes    regenerate recipes.bzl from XNU's compile records
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load(":config.bzl", "kernel_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# recipes.bzl is generated (update_recipes), not formatted by hand.
lint_files(exclude = ["recipes.bzl"])

kernel_cc_toolchain_config(
    name = "config",
    sdk = "//kernel:kernel_sdk",
    # The main repository's top-level directories with kernel sources (the drivers' tree, the pinned bindings).
    source_roots = [
        "bazel",
        "out",
    ],
)

# Xcode's identity is an input of every compile (a new Xcode re-keys them all); the headers come from the targets'
# CcInfo (//kernel:kernel_sdk and the drivers' own), so .d files prune them per object.
filegroup(
    name = "files",
    srcs = ["@xcode//:identity"],
)

cc_toolchain(
    name = "cc_toolchain",
    all_files = ":files",
    ar_files = ":files",
    as_files = ":files",
    compiler_files = ":files",
    dwp_files = ":files",
    linker_files = ":files",
    objcopy_files = ":files",
    strip_files = ":files",
    supports_param_files = False,
    toolchain_config = ":config",
)

toolchain(
    name = "toolchain",
    exec_compatible_with = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
    ],
    target_compatible_with = ["//bazel/platforms:kernel"],
    toolchain = ":cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# recipes.bzl from XNU's compile records, and the check that it is current (it fails after an XNU change that moves a
# recipe's flags: run update_recipes and commit).
RECIPES = [
    "--recipe=iokit_cxx=iokit/DEVELOPMENT/IOPlatformExpert.cpo.json",
    "--recipe=iokit_cxx_generic=iokit/DEVELOPMENT/IOPlatformExpert.cpo.json:drop=-mcpu=:drop=-march=:drop=-flto",
    "--recipe=osfmk_c=osfmk/DEVELOPMENT/arm_init.o.json",
    "--recipe=bsd_c=bsd/DEVELOPMENT/bsd_init.o.json:keep_warnings",
    "--recipe=mockfs_c=bsd/DEVELOPMENT/vfs_conf.o.json:keep_warnings:drop=-DMOCKFS=:drop=-UMOCKFS",
    "--recipe=freestanding_c=osfmk/DEVELOPMENT/arm_init.o.json:strip_includes",
]

py_test(
    name = "recipes_test",
    size = "small",
    srcs = ["//tools/kernel:recipes.py"],
    args = [
        "--check",
        "--objroot=$(rootpath //kernel:xnu)",
        "--out=$(rootpath :recipes.bzl)",
    ] + RECIPES,
    data = [
        ":recipes.bzl",
        "//kernel:xnu",
    ],
    main = "//tools/kernel:recipes.py",
)

py_binary(
    name = "update_recipes",
    srcs = ["//tools/kernel:recipes.py"],
    args = [
        "--objroot=$(rootpath //kernel:xnu)",
        "--out=bazel/toolchains/kernel/recipes.bzl",
    ] + RECIPES,
    data = ["//kernel:xnu"],
    main = "//tools/kernel:recipes.py",
)
