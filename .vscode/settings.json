{
  // Keep the editor light on this repo. 11-05: the Bazel extension's tree, test explorer and code lens left 1,183
  // `bazel query` clients (16 GB) running. The C/C++ extension and clangd indexed the same files twice, and git
  // picked up every agent worktree under out/agent-scratch.

  // Bazel: Starlark highlighting and buildifier formatting only. Nothing here runs `bazel query` on its own; build
  // and test from the terminal.
  "bazel.workspaceTree.enable": false,
  "bazel.testExplorer.enable": false,
  "bazel.codeLens.enable": false,
  "bazel.enableWorkspaceTree": false,
  "bazel.enableTestExplorer": false,
  "bazel.enableCodeLens": false,
  "bazel.languageSupport.enable": true,
  "bazel.buildifier.enable": true,
  "bazel.buildifier.executable": ".cache/editor-bin/buildifier",
  "bazel.buildifier.configJsonPath": ".cache/editor-bin/buildifier.json",
  "bazel.commandLine.queriesShareServer": false,
  "bazel.commandLine.queryOutputBase": "~/Library/Caches/bazel/editor-query-ob",
  "[starlark]": {
    "editor.defaultFormatter": "bazelbuild.vscode-bazel",
    "editor.formatOnSave": true
  },

  // C/C++: clangd only. The Microsoft extension's IntelliSense stays off, so the code is parsed once.
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.formatting": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--background-index",
    "-j=4",
    "--header-insertion=never",
    "--pch-storage=disk",
    "--log=error"
  ],
  "clangd.onConfigChanged": "restart",
  "clang-format.executable": "${workspaceRoot}/.cache/editor-bin/clang-format",
  "clang-format.fallbackStyle": "none",
  "[c][cpp][objective-c][objective-cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true
  },
  "task.allowAutomaticTasks": "on",

  // Python: Pylance analyses open files only, and never the vendored, generated or scratch trees.
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": true,
  "python.analysis.userFileIndexingLimit": 2000,
  "python.analysis.exclude": [
    "**/bazel-*",
    "out",
    "vendor",
    "third_party",
    "kernel/xnu-*",
    "**/__pycache__"
  ],
  "ruff.path": ["${workspaceFolder}/.cache/editor-bin/ruff"],
  "ruff.exclude": [
    ".agents",
    "kernel/xnu-*/libkern",
    "kernel/xnu-*/san",
    "kernel/xnu-*/tests",
    "kernel/xnu-*/tools",
    "third_party/m2v",
    "third_party/mesa/bin",
    "third_party/mesa/include",
    "third_party/mesa/src",
    "third_party/mesa/subprojects",
    "translate/arm64e/xnu",
    "vendor"
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },

  "dprint.path": "./.cache/editor-bin/dprint",
  "[json][jsonc][toml]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.formatOnSave": true
  },
  "rumdl.server.path": ".cache/editor-bin/rumdl",
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl",
    "editor.formatOnSave": true
  },
  "shfmt.executablePath": "${workspaceFolder}/.cache/editor-bin/shfmt",
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "rust-analyzer.rustfmt.overrideCommand": ["${workspaceFolder}/.cache/editor-bin/rustfmt"],
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },

  // Git: only the repository itself, never the agent worktrees or vendored clones below it.
  "git.autoRepositoryDetection": "openEditors",
  "git.repositoryScanMaxDepth": 1,
  "git.repositoryScanIgnoredFolders": [
    "out",
    "vendor",
    "third_party",
    "bazel-bin",
    "bazel-out",
    "bazel-testlogs"
  ],
  "git.detectSubmodules": false,

  // Files: never follow Bazel's output symlinks (they lead into a 10 GB+ output base) or watch the big trees.
  "search.followSymlinks": false,
  "files.watcherExclude": {
    "**/bazel-*/**": true,
    "**/out/**": true,
    "**/vendor/**": true,
    "**/.git/objects/**": true,
    "**/__pycache__/**": true,
    "**/.agents/**": true
  },
  "files.exclude": {
    "bazel-*": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/bazel-*": true,
    "out/**": true,
    "vendor/**": true,
    "MODULE.bazel.lock": true,
    "**/*.logarchive/**": true
  }
}
