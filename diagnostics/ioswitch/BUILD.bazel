# diagnostics/ioswitch: moved from out/native-a57/root-v1/tree/diagnostics/ioswitch by the layout move.
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/kernel:kernel.bzl", "kernel_driver", "kernel_headers")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

[py_test(
    name = "sdmmc_%s_test" % kind,
    size = "small",
    srcs = ["storage/tests/test_sdmmc_%s.py" % kind],
    data = glob(["storage/**"]),
    main = "storage/tests/test_sdmmc_%s.py" % kind,
    tags = ["requires-darwin"],
) for kind in ("batch", "write")]

# IOSwitchDiag: boot diagnostics, SD/FAT32/APFS storage (osfmk C recipe, no FP/SIMD).
kernel_driver(
    name = "IOSwitchDiag",
    srcs = [
        "IOSwitchDiag.c",
        "IOSwitchPanicSave.c",
        "IOSwitchFiles.c",
        "IOSwitchSD.c",
        "storage/block_backend.c",
        "storage/fat32.c",
        "storage/partition.c",
        "storage/sd_reference.c",
        "storage/sdmmc_read.c",
        "storage/split_disk.c",
        "storage/data_backend.c",
        "storage/raw_apfs.c",
        "storage/sdmmc_dma.c",
    ],
    c_copts = [
        "-DIOSWITCH_XNU_DIAGNOSTICS=1",
        "-DXNU_IOSWITCH_VERIFIED_ROOT=1",
        "-DIOSWITCH_SD_MODEL=0",
        "-mgeneral-regs-only",
        "-mstrict-align",
        "-fno-stack-protector",
        "-fno-builtin",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-I",
        "{tree}/diagnostics/ioswitch",
        "-I",
        "{tree}/kits/VerifiedRoot/include",
    ],
    hdr_deps = [
        "kits/VerifiedRoot",
    ],
)
