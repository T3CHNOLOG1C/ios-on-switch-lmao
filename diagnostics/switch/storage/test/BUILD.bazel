# The diagnostics SD transport (diagnostics/switch/storage: sdmmc_read.c, sdmmc_dma.c) on the host, the real code
# against independent SDHCI register models with fault injection: the bounded multi-block read and the write/cache
# path. GoogleTest drives each model's cases.
#
#   bazel test //diagnostics/switch/storage/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

host_library(
    name = "sdmmc",
    srcs = [
        "//diagnostics/switch:storage/sdmmc_dma.c",
        "//diagnostics/switch:storage/sdmmc_dma.h",
        "//diagnostics/switch:storage/sdmmc_read.c",
    ],
    hdrs = ["//diagnostics/switch:storage/sdmmc_read.h"],
    copts = ["-O1"],
)

host_library(
    name = "sdmmc_batch_model",
    srcs = ["sdmmc_batch_model.c"],
    copts = ["-O1"],
    deps = [
        ":sdmmc",
        "//bazel/testing:c_check",
    ],
)

host_test(
    name = "sdmmc_batch_test",
    srcs = ["sdmmc_batch_test.cpp"],
    deps = [":sdmmc_batch_model"],
)

host_library(
    name = "sdmmc_write_model",
    srcs = ["sdmmc_write_model.c"],
    copts = ["-O1"],
    deps = [
        ":sdmmc",
        "//bazel/testing:c_check",
    ],
)

host_test(
    name = "sdmmc_write_test",
    srcs = ["sdmmc_write_test.cpp"],
    deps = [":sdmmc_write_model"],
)
