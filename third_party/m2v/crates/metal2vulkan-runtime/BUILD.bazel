# metal2vulkan-runtime, the Metal API on Vulkan (lib metal2vulkan_runtime): crates/metal2vulkan-runtime/Cargo.toml.
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/rust:defs.bzl", "THIRD_PARTY_LINT_EXCLUDE", "cargo_ids")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = THIRD_PARTY_LINT_EXCLUDE)

# build.rs: M2V_RUNTIME_SOURCE_ID, the hash of the manifest, build.rs and every file below src/ (by its relative path),
# which the shader cache's build directory is keyed on beside the translator's digest.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    data = [
        "Cargo.toml",
        "build.rs",
    ] + glob(["src/**"]),
    edition = "2021",
    pkg_name = "metal2vulkan-runtime",
    version = "0.2.0",
    deps = ["@rust_crates//:sha2"],
)

rust_library(
    name = "metal2vulkan-runtime",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(
        ["src/**"],
        exclude = ["src/**/*.rs"],
    ),
    crate_name = "metal2vulkan_runtime",
    crate_root = "src/lib.rs",
    edition = "2021",
    # switch_debug: the debug profile's seed look-up latencies (shader_cache/store.rs).
    rustc_flags = cargo_ids("2feda064543aa7a8", "e61ed2ee65c85afb") + ["--cap-lints=allow"] + select({
        "//bazel:debug": ["--cfg=switch_debug"],
        "//conditions:default": [],
    }),
    version = "0.2.0",
    deps = [
        ":build_script",
        "//third_party/m2v/crates/metal2vulkan",
        "@rust_crates//:ash",
        "@rust_crates//:libc",
        "@rust_crates//:sha2",
    ],
)

# Every file of the crate the product can compile or read (the raw GM20B path's stack key hashes them: //gpu:raw_stack).
filegroup(
    name = "sources",
    srcs = [
        "Cargo.toml",
        "build.rs",
    ] + glob(["src/**"]),
)
