# rustc-hash-2.1.1 from crates.io, unchanged (the source meson extracts from its wrap, subprojects/rustc-hash-2-rs.wrap);
# built with the arguments meson's packagefiles give it (subprojects/packagefiles).
load("//bazel/lint:defs.bzl", "lint_files")
load("//third_party/mesa/bazel:defs.bzl", "MESA_LINT_EXCLUDE")
load("//third_party/mesa/bazel:rust.bzl", "mesa_rust_library")

package(default_visibility = ["//visibility:public"])

lint_files(
    dirs = [],
    exclude = MESA_LINT_EXCLUDE,
)

mesa_rust_library(
    name = "rustc_hash",
    srcs = glob(["src/**/*.rs"]),
    cap_lints = True,
    crate_features = [
        "std",
    ],
    crate_name = "rustc_hash",
    crate_root = "src/lib.rs",
    edition = "2021",
    metadata = "e6783ba@@rustc_hash@rlib",
)
