# Mesa's src/nouveau/cubin/meson.build, in Bazel: what NVK's build needs of it (third_party/mesa/bazel/defs.bzl).
# Translated from the compile, archive and generator commands of the meson builds that reproduce main's NVK dylibs.

load("//bazel/lint:defs.bzl", "lint_files")
load("//third_party/mesa/bazel:defs.bzl", "MESA_LINT_EXCLUDE", "mesa_args", "mesa_cc_library")

package(default_visibility = ["//visibility:public"])

lint_files(
    dirs = [],
    exclude = MESA_LINT_EXCLUDE,
)

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# Every header of this package, its generated ones included: //third_party/mesa:headers gathers them.
filegroup(
    name = "headers",
    srcs = glob(
        ["**/*.h"],
        allow_empty = True,
    ),
)

mesa_cc_library(
    name = "nouveau_cubin",
    c_args = mesa_args(
        "c",
        extra = [
            "-DXXH_FORCE_ALIGN_CHECK=0",
            "-DXXH_FORCE_MEMORY_ACCESS=0",
        ],
        include_dirs = [
            "gen:src/nouveau/cubin",
            "src/nouveau/cubin",
            "gen:include",
            "include",
            "gen:src",
            "src",
            "gen:src/util",
            "gen:src/util/format",
        ],
    ),
    sources = [
        "nv_cubin_none.c",
        "nv_fatbin.c",
    ],
)
