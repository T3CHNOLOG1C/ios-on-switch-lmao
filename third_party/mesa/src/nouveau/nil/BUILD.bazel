package(default_visibility = ["//visibility:public"])

lint_files(
    dirs = [],
    exclude = MESA_LINT_EXCLUDE,
)

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# Every header of this package, its generated ones included: //third_party/mesa:headers gathers them.
filegroup(
    name = "headers",
    srcs = glob(
        ["**/*.h"],
        allow_empty = True,
    ) + [
        "nil.h",
        "nil_format_table.h",
    ],
)

